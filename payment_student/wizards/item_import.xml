<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="import_form" model="ir.ui.view">
    <field name="inherit_id" ref="payment_jetcheckout_system.import_form"/>
    <field name="model">payment.item.import</field>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='line_ids']//tree" position="inside">
            <field name="student_term_name" invisible="1" force_save="1"/>
        </xpath>
        <xpath expr="//field[@name='line_ids']//form" position="inside">
            <field name="student_term_name" invisible="1" force_save="1"/>
        </xpath>
    </field>
    </record>
</odoo>
