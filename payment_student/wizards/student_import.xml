<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="import_form" model="ir.ui.view">
    <field name="name">payment.student.import.form</field>
    <field name="model">payment.student.import</field>
    <field name="arch" type="xml">
        <form>
            <group>
                <group>
                    <p class="h4 mt-n3 text-primary text-center" colspan="2"><i class="fa fa-3x fa-upload"/></p>
                    <p class="h4 mt-2 mb-4 text-primary text-center" colspan="2">Please upload a student list</p>
                    <p class="text-center" colspan="2">
                        <a role="button" href="/payment_student/static/xlsx/payment_student.xlsx" class="btn-link"><i class="fa fa-file-excel-o mr-2"/>Click here to get example template</a>
                    </p>
                    <div class="d-flex justify-content-center">
                        <field name="file" filename="filename" colspan="2" nolabel="1" class="justify-content-center mt-2 p-4 w-75 border rounded shadow-sm bg-100"/>
                        <field name="filename" invisible="1" colspan="2" nolabel="1"/>
                    </div>
                </group>
                <group>
                    <field name="line_ids" readonly="1" colspan="2" nolabel="1" force_save="1">
                        <tree create="0" edit="0" delete="0">
                            <field name="name" force_save="1"/>
                            <field name="vat" force_save="1"/>
                            <field name="ref" force_save="1" optional="hide"/>
                            <field name="email" force_save="1" optional="hide" invisible="context.get('active_subsystem') not in ('student_university',)"/>
                            <field name="phone" force_save="1" optional="hide" invisible="not context.get('active_subsystem') not in ('student_university',)"/>
                            <field name="school_name" force_save="1"/>
                            <field name="school_code" force_save="1" optional="hide"/>
                            <field name="class_name" force_save="1"/>
                            <field name="class_code" force_save="1" optional="hide"/>
                            <field name="bursary_name" force_save="1" optional="hide"/>
                            <field name="bursary_code" force_save="1" optional="hide"/>
                            <field name="term_name" force_save="1" optional="hide"/>
                            <field name="term_code" force_save="1" optional="hide"/>
                            <field name="campus_name" force_save="1" optional="hide" invisible="context.get('active_subsystem') not in ('student_university',)"/>
                            <field name="campus_code" force_save="1" optional="hide" invisible="context.get('active_subsystem') not in ('student_university',)"/>
                            <field name="faculty_name" force_save="1" optional="hide" invisible="context.get('active_subsystem') not in ('student_university',)"/>
                            <field name="faculty_code" force_save="1" optional="hide" invisible="context.get('active_subsystem') not in ('student_university',)"/>
                            <field name="department_name" force_save="1" optional="hide" invisible="context.get('active_subsystem') not in ('student_university',)"/>
                            <field name="department_code" force_save="1" optional="hide" invisible="context.get('active_subsystem') not in ('student_university',)"/>
                            <field name="program_name" force_save="1" optional="hide" invisible="context.get('active_subsystem') not in ('student_university',)"/>
                            <field name="program_code" force_save="1" optional="hide" invisible="context.get('active_subsystem') not in ('student_university',)"/>
                            <field name="parent_name" force_save="1" invisible="context.get('active_subsystem') in ('student_university',)"/>
                            <field name="parent_email" force_save="1" optional="hide" invisible="context.get('active_subsystem') in ('student_university',)"/>
                            <field name="parent_phone" force_save="1" optional="hide" invisible="context.get('active_subsystem') in ('student_university',)"/>
                            <field name="parent_campaign" force_save="1" optional="hide" invisible="context.get('active_subsystem') in ('student_university',)"/>
                        </tree>
                        <form>
                            <sheet>
                                <group>
                                    <group>
                                        <field name="name" force_save="1"/>
                                        <field name="vat" force_save="1"/>
                                        <field name="ref" force_save="1"/>
                                        <field name="email" force_save="1" invisible="context.get('active_subsystem') not in ('student_university',)"/>
                                        <field name="phone" force_save="1" invisible="context.get('active_subsystem') not in ('student_university',)"/>
                                        <field name="school_name" force_save="1"/>
                                        <field name="school_code" force_save="1"/>
                                        <field name="class_name" force_save="1"/>
                                        <field name="class_code" force_save="1"/>
                                        <field name="bursary_name" force_save="1"/>
                                        <field name="bursary_code" force_save="1"/>
                                        <field name="term_name" force_save="1"/>
                                        <field name="term_code" force_save="1"/>
                                    </group>
                                    <group invisible="context.get('active_subsystem') in ('student_university',)">
                                        <field name="parent_name" force_save="1"/>
                                        <field name="parent_email" force_save="1"/>
                                        <field name="parent_phone" force_save="1"/>
                                        <field name="parent_campaign" force_save="1"/>
                                    </group>
                                    <group invisible="context.get('active_subsystem') not in ('student_university',)">
                                        <field name="campus_name" force_save="1" optional="hide"/>
                                        <field name="campus_code" force_save="1" optional="hide"/>
                                        <field name="faculty_name" force_save="1" optional="hide"/>
                                        <field name="faculty_code" force_save="1" optional="hide"/>
                                        <field name="department_name" force_save="1" optional="hide"/>
                                        <field name="department_code" force_save="1" optional="hide"/>
                                        <field name="program_name" force_save="1" optional="hide"/>
                                        <field name="program_code" force_save="1" optional="hide"/>
                                    </group>
                                </group>
                            </sheet>
                            <footer style="display: none;"/>
                        </form>
                    </field>
                </group>
            </group>
            <footer>
                <button name="confirm" type="object" class="btn-primary" string="Import" icon="fa-upload"/>
                <button special="cancel" class="btn-secondary" string="Close" icon="fa-times"/>
            </footer>
        </form>
    </field>
    </record>

    <record id="action_import" model="ir.actions.act_window">
    <field name="name">Import Student</field>
    <field name="res_model">payment.student.import</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    </record>

</odoo>
