<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="form_provider" model="ir.ui.view">
    <field name="model">auth.oauth.provider</field>
    <field name="priority" eval="10"/>
    <field name="inherit_id" ref="auth_oauth.view_oauth_provider_form"/>
    <field name="arch" type="xml">
        <xpath expr="//sheet" position="inside">
            <group name="multitenant">
                <field name="company_id" options="{'no_create': True}"/>
            </group>
        </xpath>
    </field>
    </record>

    <record id="form_user" model="ir.ui.view">
    <field name="model">res.users</field>
    <field name="inherit_id" ref="auth_oauth.view_users_form"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='oauth_access_token']" position="after">
            <field name="oauth_ref"/>
        </xpath>
    </field>
    </record>
</odoo>