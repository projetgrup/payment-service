        }
        &:has(input[type="radio"]:checked) {
            outline: solid 2px var(--primary-color);
            background-color: var(--primary-light-color);
        }
    }
    &__listContent {
        display: flex;
        align-items: center;
        width: 100%;
    }
    &__billingControl {
        display: flex;
        
    }
  }


  .product {
    display: flex;
    flex-direction: column;
    background-color: var(--background-color);
    border-radius: toRem(10);
    &__panel {
