        top: toRem(17);
      }
      &__editBtn {
        display: flex;
        position: absolute;
        z-index: 1;
        top: toRem(17);
        right: toRem(10);
        padding: toRem(10);
        border-radius: toRem(6);
        border: solid 1px transparent;
        &:hover {
          border: solid 1px var(--color-disabled)
        }
      }
    }
    
    
    .order-summary-gray {
        position: fixed;
        background-color: var(--color-ligth-gray);
        height: 100vh;
        width: 100%;
        top: 0;
    
        @include respond-to-max("sm") {
          display: none;
        }
    }
      
    .order-summary-content {
      position: sticky;
      top: 0;
      z-index: 2;
      padding: 20px;
    }
    
    .position-relative {
      position: relative;
    }
    
    .infoIcon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background-color: var(--info-icon-background);
      color: var(--info-icon-text);
      @include toRem(font-size, 15);
      border-radius: 22px;
      height: 22px;
      width: 22px;
      text-align: center;
      font-weight: 600;
    }
    
    .loading {
      &.-white {
        color: var(--color-white);
      }
      &.-primary {
        color: var(--primary-color);
      }
      &.-small {
        
      }
    }

    .slickSheet {
      width: 100%;
      display: flex;
      flex-direction: column;
      background-color: var(--color-white);
      border-radius: 10px 10px 0 0;
    
      overflow: hidden;
      z-index: 10;
      isolation: isolate;
      border-width: 1px;
      --shadow: 0 20px 25px -5px rgba(0,0,0,.1),0 8px 10px -6px rgba(0,0,0,.1);
      --shadow-colored: 0 20px 25px -5px var(--shadow-color),0 8px 10px -6px var(--shadow-color);
      --ring-offset-shadow: 0 0 #0000;
      --ring-shadow: 0 0 #0000;
      box-shadow: var(--ring-offset-shadow,0 0 #0000),var(--ring-shadow,0 0 #0000),var(--shadow);


      &__header {
        display: flex;
        justify-content: space-between;
        padding: 1rem;
        border-bottom: solid 1px var(--color-border);
      }
      &__line {
        width: 2.5rem;
        height: .25rem;
        --bg-opacity: 1;
        background-color: rgba(161, 161, 170, var(--bg-opacity));
        border-radius: 30px;
        display: none;
      }
      &__backdrop {
        z-index: 9;
        --tw-bg-opacity: .1;
        background-color: rgba(255, 255, 255, var(--tw-bg-opacity));
        --backdrop-blur: blur(4px);
        -webkit-backdrop-filter: var(--backdrop-blur);
        backdrop-filter: var(--backdrop-blur);
      }
    }
  }


  //global settings

  // Tooltip Stili

  .tooltip {
    position: absolute;
    background: rgba(0, 0, 0, 0.85);
    color: white;
    padding: 6px 10px;
    border-radius: 5px;
    font-size: 14px;
    white-space: nowrap;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.2s ease-in-out, transform 0.2s ease-in-out;
    transform: translateY(-5px);
    pointer-events: none;
    z-index: 1000;
  }

  .tooltip.show {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }
  .tooltip::after {
    content: "";
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    border-width: 5px;
    border-style: solid;
    border-color: rgba(0, 0, 0, 0.85) transparent transparent transparent;
  }

  .tooltip.tooltip-bottom::after {
    top: -5px;
    bottom: auto;
    border-color: transparent transparent rgba(0, 0, 0, 0.85) transparent;
  }

  .hidden {
    display: none;
  }



  //DELIVERY

  .address {
    display: flex;
    flex-direction: column;
    border: solid 1px var(--color-border);
    border-radius: toRem(20);
    padding: toRem(20);
    @include toRem(margin-top, 30);

    @include respond-to-max("sm") {
        @include toRem(margin-top, 15);
    }

    &__header {
      display: flex;
      justify-content: space-between;
      align-items: center;
        h3 {
            font-size: toRem(18);
            font-weight: 600;
            color: var(--color-text);
        }
        margin-bottom: toRem(20);

        @include respond-to-max("sm") {
            margin-bottom: toRem(15);
            h3 {
                font-size: toRem(16);
            }
        }
    }
    &__body {
        display: flex;
        flex-direction: column;
    }
    &__content {
        display: none;
        flex-direction: column;
        transition: max-height 0.3s ease-in-out, opacity 0.3s ease-in-out;
        opacity: 0;
        &.-active {
          display: flex;
          opacity: 1;
          margin-top: toRem(20);
        }
    }
    &__message {
        display: flex;
        flex-basis: 25%;
        flex-shrink: 0;
        flex-grow: 1;

        p {
            width: 100%;
            font-size: toRem(12);
            font-weight: 400;
            color: var(--info-icon-text);
            margin-left: toRem(10);

            strong {
                font-weight: 600;
                text-decoration: underline;
                cursor: pointer;
                &:hover {
                    text-decoration: none;
                }
            }
        }
    }
    &__list {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: toRem(20);
        width: 100%;

        @include respond-to-max("sm") {
            flex-direction: column;
            margin-bottom: toRem(10);
        }

        &--details {
            display: flex;
            flex-direction: column;
            margin-right: toRem(10);
            padding-right: toRem(20);
            img {
              width: fit-content;
            }
            span {
                font-size: toRem(14);
                font-weight: 600;
            }
            p {
                display: flex;
                align-items: center;
                font-size: toRem(14);
                color: var(--text-color);
                line-height: toRem(18);
                margin: toRem(8) 0;

                strong {
                    font-weight: 600;
                    margin-right: toRem(10);
                }
            }
        }
    }
    &__listItem {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        width: 100%;
            max-width: 100%;
        background-color: var(--color-ligth-gray);
