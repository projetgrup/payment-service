    padding: toRem(8);
    &__box {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: toRem(20);
      &::after {
        display: flex;
        align-items: center;
        justify-content: center;
        content: "";
        margin-top: toRem(20);
        width: 90%;
        height: 1px;
        background-color: #DCE1EA;
      }
    }
    &__price {
      display: flex;
      align-items: flex-end;
    }
    &__oldPrice {
      font-size: toRem(13);
      text-decoration: line-through;
      color: var(--color-disabled);
      line-height: normal;
      margin-bottom: toRem(5);
      span {
