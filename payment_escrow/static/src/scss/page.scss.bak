          }
        }
        &:last-child {
          .summary__boxItem--name {
            margin-bottom: 0;
          }
        } 
      }

      &__list {
        display: flex;
        flex-direction: column;
        margin-top: toRem(20);
        padding: toRem(15) 0;
        border-top: solid 1px var(--color-border);
        border-bottom: solid 1px var(--color-border);

        li {
          display: flex;
          justify-content: space-between;
          text-align: center;
          font-size: toRem(14);
          padding: toRem(4) 0;
          span {
            color: var(--info-icon-text);
            font-weight: 400;
          }
          strong {
            color: var(--color-black);
            font-weight: 500;
          }
          &.total {
            font-size: toRem(16);
            span, strong {
              color: var(--primary-color);
              font-weight: 600;
            }
          }
        }
      }
    
      &__footer {
        display: flex;
        flex-direction: column;
        border-top: solid 1px var(--color-border);
      }
      &__agreement {
        display: flex;
        flex-direction: column;
        padding: toRem(30) 0 toRem(15);
    
        p {
          line-height: 1.5;
          font-size: toRem(12);
          strong {
            text-decoration: underline;
            cursor: pointer;
            &:hover {
              color: var(--primary-color);
            }
          }
        }
        .form__error {
