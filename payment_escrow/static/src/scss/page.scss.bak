        line-height: toRem(18);
        padding: 0;
        font-size: toRem(16);
        font-weight: 600;
        background-color: #f0f0f0;
        border: solid 1px #fff;
        box-shadow: rgba(33, 35, 38, .65) 0px 8px 10px -9px;
        &:hover {
          border-color: var(--primary-color);
          cursor: pointer;
        }
      }
    }
    &__control {
      padding: 0 toRem(10);
    }
    &__input {
      width: 20px;
      background-color: transparent;
      text-align: center;
      color: var(--color-black);
      font-weight: 500;
    }

    .buy-now {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      background: linear-gradient(90deg, #4a00e0, #8e2de2);
      background-size: 200% 100%;
      background-position: left center;
      color: white;
      padding: toRem(8);
      border-radius: toRem(20);
      font-size: toRem(18);
      font-weight: 600;
      text-align: center;
      border: none;
      cursor: pointer;
      box-shadow: rgba(33, 35, 38, 0.35) 0px 10px 10px -10px;
      transition: background-position 0.4s ease;
    
      .icon,
      .spacer {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
    
      .icon {
        background-color: #fff;
        border-radius: 50%;
        transition: background-color 0.3s ease, box-shadow 0.3s ease;
    
        svg {
          fill: #4a00e0;
          transition: fill 0.3s ease;
        }
      }
    
      p {
        margin: 0;
        flex: 1;
        text-align: center;
        background: linear-gradient(90deg, #ffffff, #e5e5e5);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-size: 300%;
        background-position: 0% 50%;
        transition: background-position 0.6s ease;
      }
    
      &:hover {
        background-position: right center;
    
        .icon {
          background-color: #f0ebff;
          box-shadow: 0 0 8px rgba(138, 43, 226, 0.3);
        }
    
        .icon svg {
          fill: #6a00e0;
        }
    
        p {
          background-position: 100% 50%;
        }
      }
    }

    &__installment {
      display: flex;
      flex-direction: column;
      
      p {
        font-size: toRem(13);
        font-weight: 500;
        margin-bottom: toRem(5);
      }
    }

    &__installmentGrid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      text-align: center;
      background-color: var(--color-white);
      padding: toRem(10);
      border-radius: toRem(10);
      img {
        width: auto;
        max-height: 15px;
      }

      div {
        font-size: toRem(12);
        color: #626A75;
        border-bottom: solid 1px #DCE1EA;
        border-left: solid 1px #DCE1EA;
        padding: toRem(6);
        &:nth-of-type(3n+1) {
          border-left: 0;
        }
        &:nth-last-child(-n + 3) {
          border-bottom: 0 !important;
        }
      }
    }
    &__info {
      display: flex;
      flex-direction: column;
      padding: 0 toRem(20) toRem(10);
    }
    &__infoItem {
      display: flex;
      gap: 8px;
      font-size: toRem(13);
      margin-bottom: toRem(10);
      &.-cargo {
        color: #0EB067;
      }
      &.-shoppingcredit {
        color: #FE6C43;
      }

      &:last-child {
        margin-bottom: 0;
      } 
    }
  }


  //PAYMENT LIST
  $color-stops: (
    0: #3ddc04,
    25: #f1cf0b,
    50: #f2b01e,
    75: #ed4a14,
    100: #ef0000
  );



  @function get-color($value) {
    @each $stop, $color in $color-stops {
      @if $value == $stop {
        @return $color;
      }
    }

    $lower-stop: null;
    $upper-stop: null;
    $lower-color: null;
    $upper-color: null;

    @each $stop, $color in $color-stops {
      @if $stop < $value {
        $lower-stop: $stop;
        $lower-color: $color;
      } @else if $upper-stop == null and $stop > $value {
        $upper-stop: $stop;
        $upper-color: $color;
      }
    }

    /*@if $lower-color and $upper-color {
      $percent: math.div($value - $lower-stop, $upper-stop - $lower-stop);
      @return color.mix($upper-color, $lower-color, $percent * 100%);
    }*/

    @return #ccc;
  }


  .paymentList {
    margin-top: toRem(30);
    &__header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: toRem(20);
      padding-bottom: toRem(15);
      border-bottom: solid 1px var(--color-border);
    }
    &__actions {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
  }
  .paymentTable {
    &__header {
      font-size: toRem(12);
      font-weight: 600;
      margin-bottom: toRem(10);
    }
    &__actions {
      display: flex;
      gap: toRem(10);
      width: 100%;
      background-color: var(--color-white);
      padding: toRem(5) toRem(10);
      margin-bottom: toRem(10);
      height: toRem(30);
      border-top-left-radius: toRem(6);
      border-bottom-left-radius: toRem(6);
      .btn__remove {
        display: flex;
        span {
          color: var(--text-color);
          font-size: toRem(12);
          margin-left: toRem(8);
        }
      }
    }
    &__item {
      background-color: #F5F7F9;
      border: solid 1px transparent;
      border-radius: toRem(10);
      padding: toRem(10);
      margin-bottom: toRem(10);
      .col {
        &:last-child {
          .item {
            &-value {
              border-top-right-radius: toRem(6);
              border-bottom-right-radius: toRem(6);
            }
          }
        }
      }
      &.-selected {
        border-color: #BCE5AA;
        background-color: #F8FFF7;
      }
    }
    &__info {
      display: grid;
      grid-template-columns: 16px 1fr;
      gap: 5px;

      .infoIcon {
        width: toRem(16);
        height: toRem(16);
        font-size: toRem(12);
      }
      p {
        font-size: toRem(12);
        line-height: normal;
      }
    }
    .item {
      &-value {
        display: flex;
        width: 100%;
        font-size: toRem(14);
        font-weight: 600;
        background-color: var(--color-white);
        padding: toRem(5) toRem(20);
        margin-bottom: toRem(10);
        position: relative;
        height: toRem(30);
      
        &::before {
          content: "";
          height: 20px;
          border-left: solid 1px #E5EAF0;
          position: absolute;
          left: 0;
        }
      }
      &-progress {
        display: flex;
        flex-direction: column;
        padding: 0 toRem(20);
        &-bar {
          display: flex;
          width: 100%;
          height: toRem(6);
          border-radius: toRem(10);
          background-color: #DEE2E6;

          span {
            width: var(--progress);
            border-radius: toRem(10);
            transition: width 0.3s ease-in-out;
            background-color: #f63a0f;
            background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0.05));
            transition-property: width, background-color;

            @for $i from 0 through 100 {
              &[style*="#{$i}%"] {
                background-color: get-color($i);
              }
            }
          }
        }
        &-text {
          font-size: toRem(11);
          color: #626A75;
          margin-top: toRem(3);
        }
        &.large {
          padding: 0;
          margin-top: toRem(10);
          .item-progress {
            &-bar {
              height: toRem(10);
            }
            &-text {
              font-size: toRem(14);
            }
          }
        }
      }
      &-amount {
        font-size: toRem(12);
        padding: 0 toRem(20);
        &.-remainder {
          color: var(--color-error);
        }
        &.-paid {
          color: var(--color-success);
        }
      }
    }
  }


  .history {
    display: flex;
    flex-direction: column;
    padding: 0 toRem(20);

    &__title {
      display: flex;
      flex-direction: column;
      font-size: toRem(16);
      padding: toRem(15) 0;
      margin-bottom: toRem(15);
      border-bottom: solid 1px var(--color-border);
    }
  }


  //Payment History
  .table {
    width: 100%;
    border: none;
    border-collapse: collapse;
    &__actions {
      display: flex;
      align-items: center;
      gap: 5px;
    }
    thead {
      tr {
        th {
          font-weight: 500;
          font-size: toRem(11);
          color: var(--text-color);
          padding: toRem(10);
          text-align: left;
        }
      }
    }
    tbody {
      tr {
        background-color: var(--color-ligth-gray);
        td {
          font-weight: 500;
          font-size: toRem(11);
          color: var(--text-color);
          padding:toRem(5) toRem(10);
          border: solid 1px var(--color-border);

          .flex-direction {
            display: flex;
            flex-direction: column;
          }

          .btn {
            &__info {
              display: inline-flex;
              align-items: center;
              justify-content: center;
              width: toRem(30);
              height: toRem(30);
              padding: toRem(3);
              background-color: var(--color-white);
              border: solid 1px var(--color-disabled);
              transition: all .4s ease;
              border-radius: toRem(5);
              box-shadow: rgba(33, 35, 38, 0.35) 0px 10px 10px -10px;
              cursor: pointer;

              &:hover {
                border: solid 1px var(--color-black);
              }
            }
          }
        }
      }
    }
  }


  .badge {
    display: inline-flex;
    position: relative;
    padding: toRem(3) toRem(10);
    border-radius: toRem(20);
    transition: width 0.3s ease-in-out;
    background-color: #f63a0f;
    background-image: linear-gradient(to bottom, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0.05));
    transition-property: width, background-color;
    color: var(--color-white);
    font-size: toRem(10);

    &.-error {
      background-color: var(--color-danger-color);
    }
    &.-success {
      background-color: var(--color-success);
    }
    &.-warning {
      background-color: var(--color-warning);
    }
    &.-pending {
      background-color: var(--color-black);
    }
    &.-suspend {
      background-color: var(--color-disabled);
    }

    &::before {
      content: "";
      width: 100%;
      height: 100%;
      position: absolute;
      left: 0;
    }
  }




  //PANEL

  .panel {
    display: flex;
    flex-direction: column;
    background-color: var(--panel-color);
    border-radius: toRem(20);
    padding: toRem(20);
    margin: toRem(30) 0;

    &__header {
      text-align: center;
      h3 {
        font-size: toRem(16);
        font-weight: 600;
      }
    }
    &__body {

    }
  }


  //UPLOAD FILE

  .upload {
    width: 100%;
    position: relative;
    border: dashed 1px #ddd;
    border-radius: toRem(10);

    input[type="file"] {
      display: none;
    }
    label {
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
      font-size: toRem(14);
      font-weight: 500;
      text-align: center;
      padding: toRem(15);
      border-radius: 0.31em;
      cursor: pointer;
    }
    #num-of-files {
      font-size: toRem(11);
      font-weight: 400;
      text-align: center;
    }
    ul {
      list-style-type: none;
      li {
        font-weight: 500;
        background-color: #eff5ff;
        color: #025bee;
        margin-bottom: 1em;
        padding: 1.1em 1em;
        border-radius: 0.3em;
        display: flex;
        justify-content: space-between;
      }
    }
  }


  .download {
    display: flex;
    align-items: center;
    border: dashed 1px var(--primary-color);
    background-color: #F4F3FF;
    border-radius: toRem(10);
    padding: toRem(10);
    margin: toRem(15) 0;

    &__link {
      font-size: toRem(14);
      color: var(--primary-color);
      text-decoration: underline;
      margin-left: toRem(10);
    }
  }


  .selectCartType {
    display: flex;
    align-items: flex-start;
    gap: toRem(14);
    margin-top: toRem(30);
    &__title {
      display: flex;
      flex-direction: column;
      strong {
        font-size: toRem(14);
        line-height: normal;
        margin-bottom: toRem(4);
      }
      p {
        font-size: toRem(13);
        color: var(--info-icon-text);
      }
    }
  }



  //ADS

  $color-bg: #fff;
  $color-title: #222;
  $color-main: #1E1E1E;
  $color-btn-bg: #ededed;
  $color-active: #1E1E1E;
  $color-muted: #9BA3AF;
  $color-table-bg: #f7f8fa;
  $color-status-sold: #ff5255;
  $color-status-active: #4AC643;
  $color-status-pending: #F8A941;
  $color-row-hover: rgba(36, 20, 216, 0.05);


  .add-options {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: toRem(10);
    margin-bottom: toRem(18);

    .ad-list-title {
      font-size: toRem(14);
      font-weight: 600;
      margin-bottom: toRem(12);
      color: $color-title;
      letter-spacing: -0.2px;
    }

    .ad-list-control {
      display: flex;
      align-items: center;
      gap: toRem(16);
      flex-wrap: wrap;

      .button__primary {
        border-radius: toRem(6);
        padding: toRem(6) toRem(14);
        font-size: toRem(13);
        cursor: pointer;
      }

      .ad-list-type {
        display: flex;
        gap: toRem(4);
        .add-btn {
          background-color: $color-btn-bg;
          color: $color-main;
          padding: toRem(6) toRem(14);
          border-radius: toRem(6);
          font-size: toRem(13);
          border: none;
          cursor: pointer;
          transition: background 0.15s;
          box-shadow: none;

          &:hover {
            background: #ddd;
          }

          span {
            font-size: toRem(15);
            font-weight: bold;
            color: $color-main;
            margin-right: 2px;
          }

          &.active {
            background: $color-active;
            color: #fff;
          }
        }
      }
    }
  }


  .listing-container {
    width: 100%;
    padding-top: 32px;
    background: $color-bg;

    .ad-list-title {
      font-size: toRem(14);
      font-weight: 600;
      margin-bottom: 24px;
      color: $color-title;
    }

    .ad-list-table {
    
      display: flex;
      flex-direction: column;
      gap: 0;
      border-radius: toRem(15);
      padding: toRem(10);

      .ad-list-header,
      .ad-list-row {
        display: flex;
        align-items: center;
        width: 100%;
      }

      .ad-list-header {
        color: #1E1E1E;
        font-size: toRem(12);
        font-weight: 500;
        padding: 0 toRem(10) toRem(10);
      }

      .ad-list-row {
        background: #fff;
        border: solid 10px $color-table-bg;
        border-radius: toRem(14);
        padding: toRem(4) toRem(10);
        margin-bottom: toRem(10);
        transition: box-shadow 0.15s;

        &:hover {
          box-shadow: 0 6px 24px 0 $color-row-hover;
        }

        .ad-list-row-info {
          display: flex;
          align-items: center;
          flex: 2;
          font-size: toRem(13);
          font-weight: 500;
          color: #23262F;
          border-right: solid 1px #E5EAF0;
        }
        .ad-figure {
          display: flex;
          width: 40px;
          max-height: 40px;

          img {
          width: 100%;
          }
        }
        .ad-list-row-cat {
          flex: 1;
          font-size: toRem(13);
          color: $color-muted;
          border-right: solid 1px #E5EAF0;
          padding-left: toRem(15);
        }
        .ad-list-row-price {
          flex: 1;
          font-size: toRem(13);
          font-weight: 500;
          color: $color-main;
          border-right: solid 1px #E5EAF0;
          padding-left: toRem(15);
        }
        .ad-list-row-status {
          flex: 1;
          padding-left: toRem(15);

          .status {
            display: inline-block;
            padding: toRem(3) toRem(10);
            font-size: toRem(10);
            font-weight: 500;
            border-radius: 20px;
            color: #fff;
            background: #d0d0d0;

            &.sold { background: $color-status-sold; }
            &.active { background: $color-status-active; }
            &.pending { background: $color-status-pending; color: #fff; }
          }
        }
        .ad-list-row-arrow {
          width: 40px;
          text-align: center;
          display: flex;
          justify-content: center;
          align-items: center;
          flex-shrink: 0;

          svg {
            width: 22px;
            height: 22px;
            stroke: #23262F;
          }
        }
      }


      &.list-view {
        display: flex;
        flex-direction: column;

        .ad-list-row {
          display: flex;
          flex-direction: row;
          align-items: center;
          gap: 0;
        }
      }
      &.grid-view {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: toRem(12);
        
        .ad-list-header {
          display: none;
        }
        .ad-list-row {
          display: flex; // MUTLAKA EKLE
          flex-direction: column;
          align-items: flex-start;
          border: solid 1px #f3f3f3;
          min-height: 120px;
          padding: toRem(16) toRem(12);

          .ad-list-row-info, .ad-list-row-cat, .ad-list-row-price, .ad-list-row-status {
            padding-left: 0;
            border-right: 0;
          }
          .ad-list-row-arrow {
            display: none;
          }
        }
        .ad-list-row-arrow { align-self: flex-end; }
      }
    }
  }

  // Responsive
  @media (max-width: 600px) {
    .add-options {
      .ad-list-title { font-size: toRem(12); }
      .ad-list-control {
        gap: toRem(8);

        .add-btn { font-size: toRem(11); padding: toRem(5) toRem(11); }
        .ad-list-type {
          gap: toRem(6);
          .add-btn { font-size: toRem(11); }
        }
      }
    }
  }


  @media (max-width: 800px) {
    .ad-list-table.grid-view {
      grid-template-columns: 1fr;
    }
    .add-options {
      flex-direction: column;
      align-items: flex-start;
      gap: toRem(4);
      .ad-list-control { margin-left: 0; }
    }
  }

  // Responsive
  @media (max-width: 900px) {
    .listing-container {
      padding: 0;
      .ad-list-row, .ad-list-header { padding-left: 8px; padding-right: 8px; }
    }
  }
  @media (max-width: 600px) {
    .listing-container {
      max-width: 100%;
      .ad-list-row, .ad-list-header {
        flex-wrap: wrap;
        padding: 12px 2vw;
        margin: 10px 2vw;
      }
      .ad-list-row-info { font-size: 1rem; }
      .ad-list-row-cat, .ad-list-row-price, .ad-list-row-status { font-size: 0.95rem; }
      .add-listing { margin: 28px 0 18px 0; }
      .ad-list-title { font-size: 1.3rem; }
    }
  }



  //ILAN DETAY

  .ad-detail-header {
    display: flex;
    align-items: center;
    gap: 18px;

    border: solid 1px #f0f0f0;
    border-radius: 10px;
      padding: toRem(15);
      margin-bottom: toRem(20);

    .ad-detail-img {
      width: 58px;
      height: 58px;
      border-radius: 12px;
      object-fit: cover;
    }

    .ad-detail-title {
      font-size: 1.2rem;
      margin: 0;
    }

    .ad-detail-cat {
      color: #9BA3AF;
      margin-top: 2px;
    }
  }

  .ad-detail-body {
    margin-top: 18px;

    .ad-detail-price {
      font-weight: 600;
      color: #222;
    }

    .ad-detail-status {
      display: inline-block;
      margin: 8px 0;
      padding: 5px 16px;
      border-radius: 14px;
      font-size: toRem(12);
      color: #fff;

      &.sold {
        background: #ff5255;
      }

      &.active {
        background: #4AC643;
      }

      &.pending {
        background: #F8A941;
        color: #fff;
      }
    }

    .ad-detail-desc {
      border-top: solid 1px #f0f0f0;
      padding-top: toRem(15);
      margin-top: toRem(15);
      color: #333;
      font-size: toRem(14);
    }
  }

  @keyframes modalFadeIn {
    from {
      opacity: 0;
      transform: translateY(20px) scale(.97);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

}
