<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-extend="ListView.buttons" t-name="BrandListView.buttons">
        <t t-jquery="div > t:last-child" t-operation="before">
            <button type="button" class="btn btn-secondary o_button_sync_brand">
                Sync Brands
            </button>
        </t>
    </t>

    <t t-name="payment_escrow.sync_buttons">
        <div class="d-flex" role="toolbar" aria-label="Main actions">
            <button type="button" class="btn btn-primary o_list_button_sync" title="Sync" accesskey="s">
                Sync
            </button>
            <button type="button" class="btn btn-secondary o_list_button_discard" title="Discard" accesskey="j">
                Discard
            </button>
        </div>
    </t>

    <t t-name="payment_escrow.BrandSyncProgressWidget">
        <div class="o_brand_sync_progress_widget" style="position: fixed; bottom: 20px; right: 20px; width: 350px; z-index: 9999;">
            <div class="alert alert-info mb-0 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong>Brand Sync Progress</strong>
                    <span class="badge badge-primary"><t t-esc="processed"/> / <t t-esc="total"/></span>
                </div>
                <div class="progress mb-2" style="height: 25px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated" 
                         role="progressbar" 
                         t-att-style="'width: ' + percent + '%'"
                         t-att-aria-valuenow="percent" 
                         aria-valuemin="0" 
                         aria-valuemax="100">
                        <t t-esc="percent"/>%
                    </div>
                </div>
                <small class="text-muted"><t t-esc="message"/></small>
            </div>
        </div>
    </t>
</templates>