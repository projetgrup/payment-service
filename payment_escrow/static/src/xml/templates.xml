<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="paylox.escrow.list.item">
        <div class="escrow-ad-list-item" t-att-data-id="ad.id" data-value="" field="ad.item">
            <div class="escrow-ad-item-info">
                <div class="escrow-ad-item-image">
                    <img t-attf-src="data:image/png;base64,{{ad.img}}" alt="" name="img"/>
                </div>
                <span class="escrow-ad-item-name" t-esc="ad.name" name="name" field="ad.input.name"/>
            </div>
            <div class="escrow-ad-item-categ" t-esc="ad.categ[1]" t-att-data-id="ad.categ[0]" name="categ"/>
            <div class="escrow-ad-item-price" t-esc="format.currency(ad.price, currency.position, currency.symbol, currency.decimal)" t-att-data-value="ad.price" name="price"/>
            <div class="escrow-ad-item-state"><span class="danger">Sold</span></div>
            <div class="escrow-ad-item-arrow"><i class="fa fa-chevron-right"/></div>
            <div class="escrow-ad-item-desc d-none" t-raw="ad.desc" name="desc"/>
        </div>
    </t>

    <t t-name="paylox.escrow.grid.item">
        <div class="escrow-ad-grid-item" t-att-data-id="ad.id" field="ad.item">
            <div class="escrow-ad-grid-item-header">
                <div class="escrow-ad-figure">
                    <img t-attf-src="data:image/png;base64,{{ad.img}}" alt="" name="img"/>
                </div>
                <span t-esc="ad.name" name="name"/>
            </div>
            <div class="escrow-ad-grid-item-body">
                <div class="escrow-ad-grid-item-categ" t-esc="ad.categ[1]" t-att-data-id="ad.categ[0]" name="categ"/>
                <div class="escrow-ad-grid-item-price" t-esc="format.currency(ad.price, currency.position, currency.symbol, currency.decimal)" t-att-data-value="ad.price" name="price"/>
                <div class="escrow-ad-grid-item-status"><span class="danger">Sold</span></div>
            </div>
        </div>
    </t>

    <t t-name="paylox.escrow.transaction.item">
        <div class="success-icon-container text-center mt-2 mb-4">
            <div t-if="state === 'success' or state === 'partial'" class="success-icon">
                <i class="fa fa-expeditedssl text-success" style="font-size: 4rem;"/>
            </div>
            <div t-else="" class="success-icon">
                <i class="fa fa-exclamation-triangle text-danger" style="font-size: 4rem;"/>
            </div>
            <div t-if="state === 'partial' or state === 'success'" class="completion-message text-center">
                <h4 class="text-success mb-3">Payment Successfully Completed!</h4>
                <p class="text-muted mb-4">
                    Your escrow payment has been processed successfully. 
                    The transaction is now secure and the funds have been transferred to the escrow account.
                </p>
            </div>
            <div t-if="!paid and (state === 'error' or state === 'failed')" class="completion-message text-center">
                <h4 class="text-danger mb-3">Payment Failed!</h4>
                <p class="text-muted mb-4">
                    Your escrow payment has failed. 
                    You can see the failure reason from the payment history below.
                </p>
            </div>
        </div>


        <div class="transaction-summary mb-4">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-title">Transaction Summary</h6>
                    <div class="row paylox-transaction-summary">
                        <div class="transaction-summary">
                            <div class="row mb-3">
                                <div class="col-4">
                                    <small class="text-muted">Total Amount:</small>
                                    <div class="font-weight-bold text-nowrap" t-esc="format.currency(total_amount, currency.position, currency.symbol, currency.decimal)">0</div>
                                </div>
                                <div class="col-4">
                                    <small class="text-muted">Paid Amount:</small>
                                    <div class="text-success font-weight-bold text-nowrap" t-esc="format.currency(previous_amount, currency.position, currency.symbol, currency.decimal)">0</div>
                                </div>
                                <div class="col-4">
                                    <small class="text-muted">Remaining Amount:</small>
                                    <div class="text-danger font-weight-bold text-nowrap" t-esc="format.currency(remaining_amount, currency.position, currency.symbol, currency.decimal)">0</div>
                                </div>
                            </div>
                            
                            <div class="col-12 mb-3" t-if="paid">
                                <div class="alert alert-success">
                                    <i class="fa fa-check-circle"></i> Payment Completed
                                </div>
                            </div>
                            
                            <div t-if="transactions and transactions.length > 0">
                                <h5 class="mb-3">Payment History</h5>
                                <div class="transaction-list">
                                    <t t-foreach="transactions" t-as="payment" t-key="payment.id">
                                        <div class="transaction-item border rounded p-3 mb-2">
                                            <div class="row">
                                                <div class="col-6">
                                                    <small class="text-muted">Reference:</small>
                                                    <div class="font-weight-bold text-nowrap" t-esc="payment.reference">No Reference</div>
                                                </div>
                                                <div class="col-6">
                                                    <small class="text-muted">Amount:</small>
                                                    <div t-attf-class="font-weight-bold text-nowrap {{ payment.status === 'done' ? 'text-success' : payment.status === 'error' ? 'text-danger' : 'text-muted' }}" t-esc="format.currency(payment.amount, currency.position, currency.symbol, currency.decimal)">0</div>
                                                </div>
                                                <div class="col-6">
                                                    <small class="text-muted">Date:</small>
                                                    <div class="text-nowrap" t-esc="new Date(payment.date).toLocaleDateString('tr-TR')">-</div>
                                                </div>
                                                <div class="col-6">
                                                    <small class="text-muted">Status:</small>
                                                    <div>
                                                        <span t-attf-class="text-nowrap badge badge-pill {{ payment.status === 'done' ? 'badge-success' : payment.status === 'error' ? 'badge-danger' : 'badge-dark' }}" t-esc="payment.status">-</span>
                                                    </div>
                                                </div>
                                                <div t-if="payment.status !== 'done' and payment.message" class="col-12 border-top mt-2 text-muted small">
                                                    <small class="text-muted">Message:</small>
                                                    <div t-esc="payment.message"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                            
                            <div t-if="!transactions or transactions.length === 0" class="text-center text-muted">
                                <i class="fa fa-info-circle"></i> No payments found
                            </div>
                        </div>
                        
                    </div>
                    <div class="row mt-2">
                        <div class="col-6">
                            <small class="text-muted">Status:</small>
                            <div field="payment.transaction.status"></div>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Date:</small>
                            <div field="payment.transaction.date"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
