<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="paylox.escrow.list.item">
        <div class="escrow-ad-list-item" t-att-data-id="ad.id" data-value="" field="ad.item">
            <div class="escrow-ad-item-info">
                <div class="escrow-ad-item-image">
                    <img t-attf-src="data:image/png;base64,{{ad.img}}" alt="" name="img"/>
                </div>
                <span class="escrow-ad-item-name" t-esc="ad.name" name="name"/>
            </div>
            <div class="escrow-ad-item-categ" t-esc="ad.categ[1]" t-att-data-id="ad.categ[0]" name="categ"/>
            <div class="escrow-ad-item-price" t-esc="format.currency(ad.price, currency.position, currency.symbol, currency.decimal)" t-att-data-value="ad.price" name="price"/>
            <div class="escrow-ad-item-state"><span class="danger">Satıldı</span></div>
            <div class="escrow-ad-item-arrow"><i class="fa fa-chevron-right"/></div>
            <div class="escrow-ad-item-desc d-none" t-raw="ad.desc" name="desc"/>
        </div>
    </t>

    <t t-name="paylox.escrow.grid.item">
        <div class="escrow-ad-grid-item" t-att-data-id="ad.id" field="ad.item">
            <div class="escrow-ad-grid-item-header">
                <div class="escrow-ad-figure">
                    <img t-attf-src="data:image/png;base64,{{ad.img}}" alt="" name="img"/>
                </div>
                <span t-esc="ad.name" name="name"/>
            </div>
            <div class="escrow-ad-grid-item-body">
                <div class="escrow-ad-grid-item-categ" t-esc="ad.categ[1]" t-att-data-id="ad.categ[0]" name="categ"/>
                <div class="escrow-ad-grid-item-price" t-esc="format.currency(ad.price, currency.position, currency.symbol, currency.decimal)" t-att-data-value="ad.price" name="price"/>
                <div class="escrow-ad-grid-item-status"><span class="danger">Satıldı</span></div>
            </div>
        </div>
    </t>

    <t t-name="paylox.escrow.transaction.item">
        <t t-foreach="transactions" t-as="payment" t-key="payment.id">
            <div class="col-6">
                <small class="text-muted">Transaction ID:</small>
                <div t-esc="payment.transaction.reference">#TXN-12345</div>
            </div>
            <div class="col-6">
                <small class="text-muted">Amount:</small>
                <div t-esc="payment.amount.total">2.400.000 TL</div>
            </div>
        </t>
    </t>
</templates>
