<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tree_owner" model="ir.ui.view">
    <field name="name">res.partner.escrow.owner.tree</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
        <tree>
            <field name="active" invisible="1"/>
            <field name="name"/>
            <field name="vat" string="Vat"/>
            <field name="mobile"/>
            <field name="email"/>
            <field name="company_id" groups="base.group_multi_company,base.group_system" options="{'no_create': True, 'no_open': True}"/>
        </tree>
    </field>
    </record>

    <record id="kanban_owner" model="ir.ui.view">
    <field name="name">res.partner.escrow.owner.kanban</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
        <kanban>
            <field name="id"/>
            <field name="name"/>
            <field name="image_128"/>
            <field name="avatar_128"/>
            <templates>
                <t t-name="kanban-box">
                    <div class="oe_kanban_global_click">
                        <div class="o_kanban_image">
                            <img alt="" t-if="record.image_128.raw_value" t-att-src="kanban_image('res.partner', 'avatar_128', record.id.raw_value)"/>
                            <img alt="" t-else="" t-att-src="_s + &quot;/base/static/img/avatar_grey.png&quot;"/>
                        </div>
                        <div class="oe_kanban_details">
                            <div class="d-flex align-items-center justify-content-between">
                                <strong><field name="name"/></strong>
                            </div>
                            <ul/>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
    </record>

    <record id="form_owner" model="ir.ui.view">
    <field name="name">res.partner.escrow.owner.form</field>
    <field name="model">res.partner</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="payment_jetcheckout_system.partner_form"/>
    <field name="arch" type="xml">
        <xpath expr='//div[@name="button_box"]' position="replace"/>
        <xpath expr='//header' position="replace"/>
        <xpath expr='//field[@name="lang"]' position="after">
            <field name="category_id" widget="many2many_tags" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]" options="{'color_field': 'color', 'no_create': True}" placeholder="Tags..."/>
        </xpath>
        <xpath expr='//field[@name="company_id"]' position="before">
            <field name="acquirer_branch_id" string="Branch" domain="[('company_id', '=', company_id)]"/>
            <field name="is_company" invisible="1"/>
        </xpath>
        <xpath expr='//field[@name="mobile"]' position="before">
            <field name="phone" widget="phone"/>
        </xpath>
        <xpath expr='//field[@name="acquirer_branch_id"]' position="replace"/>
        <xpath expr='//group[@name="communication"]' position="replace"/>
        <xpath expr='//group[@name="payment"]' position="replace"/>
        <xpath expr='//field[@name="parent_id"]' position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr='//notebook' position="replace"/>
    </field>
    </record>

    <record id="search_owner" model="ir.ui.view">
    <field name="name">res.partner.escrow.owner.search</field>
    <field name="model">res.partner</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="payment_jetcheckout_system.partner_search"/>
    <field name="arch" type="xml">
        <xpath expr='//field[@name="vat"]' position="before">
            <field name="ref"/>
        </xpath>
        <xpath expr='//field[@name="vat"]' position="after">
            <field name="mobile"/>
            <field name="user_id"/>
            <field name="team_id"/>
        </xpath>
        <xpath expr='//group' position="before">
            <separator/>
            <filter name="filterby_email_send_ok" string="Sending Email active" domain="[('should_send_email', '=', True)]"/>
            <filter name="filterby_email_send_no" string="Sending Email passive" domain="[('should_send_email', '=', False)]"/>
            <separator/>
            <filter name="filterby_sms_send_ok" string="Sending SMS active" domain="[('should_send_sms', '=', True)]"/>
            <filter name="filterby_sms_send_no" string="Sending SMS passive" domain="[('should_send_sms', '=', False)]"/>
        </xpath>
        <xpath expr='//group' position="inside">
            <filter string="Sales Person" name="groupby_salesperson" domain="[]" context="{'group_by':'user_id'}"/>
            <filter string="Sales Team" name="groupby_salesteam" domain="[]" context="{'group_by':'team_id'}"/>
        </xpath>
    </field>
    </record>

    <record id="tree_customer" model="ir.ui.view">
    <field name="name">res.partner.escrow.customer.tree</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
        <tree>
            <field name="active" invisible="1"/>
            <field name="name"/>
            <field name="vat" string="Vat"/>
            <field name="mobile"/>
            <field name="email"/>
            <field name="company_id" groups="base.group_multi_company,base.group_system" options="{'no_create': True, 'no_open': True}"/>
        </tree>
    </field>
    </record>

