<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tree_owner" model="ir.ui.view">
    <field name="name">res.partner.escrow.owner.tree</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
        <tree>
            <field name="active" invisible="1"/>
            <field name="name"/>
            <field name="vat" string="Vat"/>
            <field name="mobile"/>
            <field name="email"/>
            <field name="company_id" groups="base.group_multi_company,base.group_system" options="{'no_create': True, 'no_open': True}"/>
        </tree>
    </field>
    </record>

    <record id="kanban_owner" model="ir.ui.view">
    <field name="name">res.partner.escrow.owner.kanban</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
        <kanban>
            <field name="id"/>
            <field name="name"/>
            <field name="image_128"/>
            <field name="avatar_128"/>
            <templates>
                <t t-name="kanban-box">
                    <div class="oe_kanban_global_click">
                        <div class="o_kanban_image">
                            <img alt="" t-if="record.image_128.raw_value" t-att-src="kanban_image('res.partner', 'avatar_128', record.id.raw_value)"/>
                            <img alt="" t-else="" t-att-src="_s + &quot;/base/static/img/avatar_grey.png&quot;"/>
                        </div>
                        <div class="oe_kanban_details">
                            <div class="d-flex align-items-center justify-content-between">
                                <strong><field name="name"/></strong>
                            </div>
                            <ul/>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
    </record>

    <record id="form_owner" model="ir.ui.view">
    <field name="name">res.partner.escrow.owner.form</field>
    <field name="model">res.partner</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="payment_jetcheckout_system.partner_form"/>
    <field name="arch" type="xml">
        <xpath expr='//div[@name="button_box"]' position="replace"/>
        <xpath expr='//header' position="replace"/>
        <xpath expr="//field[@name='vat']" position="before">
            <span class="o_form_label o_td_label" name="address_name">
                <b>Address</b>
            </span>
            <div class="o_address_format">
                <field name="street" placeholder="Street..." class="o_address_street"/>
                <!--<field name="street2" placeholder="Street 2..." class="o_address_street"/>-->
                <field name="city" placeholder="City" class="o_address_city"/>
                <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_create': True}" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                <field name="country_id" placeholder="Country" class="o_address_country" options="{'no_open': True, 'no_create': True}"/>
            </div>
        </xpath>
        <xpath expr="//field[@name='vat']" position="after">
            <field name="paylox_tax_office"/>
        </xpath>
        <xpath expr='//field[@name="lang"]' position="after">
            <field name="category_id" widget="many2many_tags" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]" options="{'color_field': 'color', 'no_create': True}" placeholder="Tags..."/>
        </xpath>
        <xpath expr='//field[@name="company_id"]' position="before">
            <field name="acquirer_branch_id" string="Branch" domain="[('company_id', '=', company_id)]"/>
            <field name="is_company" invisible="1"/>
        </xpath>
        <xpath expr='//field[@name="mobile"]' position="before">
            <field name="phone" widget="phone"/>
        </xpath>
        <xpath expr='//field[@name="acquirer_branch_id"]' position="replace"/>
        <xpath expr='//group[@name="communication"]' position="replace"/>
        <xpath expr="//group[@name='payment']" position="replace">
            <group/>
            <group string="Bank Accounts" name="banks">
                <field name="bank_ids" nolabel="1" colspan="2" attrs="{'invisible': [('payment_item_bank_token_ok', '!=', False)]}">
                    <tree editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="acc_number"/>
                        <field name="api_merchant" required="1"/>
                        <field name="api_result" string=" "/>
                        <field name="api_message" optional="hide"/>
                        <field name="api_state" invisible="1"/>
                        <button name="action_api_save" string="" type="object" class="btn btn-link text-primary" icon="fa-save mr-1" attrs="{'invisible': [('api_state', '=', True)]}"/>
                        <button name="action_api_query" string="" type="object" class="btn btn-link text-primary" icon="fa-search mr-1" attrs="{'invisible': [('acc_number', '=', False)]}"/>
                    </tree>
                </field>
                <field name="bank_ids_with_form" nolabel="1" colspan="2" string="Banks" attrs="{'invisible': [('payment_item_bank_token_ok', '=', False)]}">
                    <tree>
                        <field name="sequence" widget="handle"/>
                        <field name="acc_number"/>
                        <field name="acc_holder_name"/>
                        <field name="api_result" string=" " width="0.1"/>
                        <field name="api_message" optional="hide"/>
                        <field name="api_state" invisible="1"/>
                        <button name="action_api_save" string="" type="object" class="btn btn-link text-primary" icon="fa-save mr-1" attrs="{'invisible': [('api_state', '=', True)]}"/>
                        <button name="action_api_query" string="" type="object" class="btn btn-link text-primary" icon="fa-search mr-1" attrs="{'invisible': [('acc_number', '=', False)]}"/>
                    </tree>
                    <form>
                        <sheet>
                            <div class="oe_title">
                                <label for="acc_number" string="IBAN"/>
                                <h1><field name="acc_number"/></h1>
                            </div>
                            <group class="d-flex">
                                <group class="h-25">
                                    <field name="acc_holder_name"/>
                                    <label for="api_message" attrs="{'invisible': [('api_message', '=', False)]}"/>
                                    <div class="o_row" attrs="{'invisible': [('api_message', '=', False)]}">
                                        <field name="api_result" nolabel="1" style="max-width: 10px;"/>
                                        <field name="api_message" nolabel="1" readonly="1"/>
                                        <field name="api_state" invisible="1"/>
                                    </div>
                                </group>
                                <group>
                                    <field name="api_token_ids" nolabel="1">
                                        <tree editable="bottom">
                                            <field name="sequence" widget="handle"/>
                                            <field name="api_ref" readonly="1" force_save="1"/>
                                            <field name="item_ids" invisible="1"/>
                                            <field name="acc_number" invisible="1"/>
                                            <field name="api_merchant" required="1"/>
                                            <field name="item_ok" string="Linked"/>
                                            <field name="api_result" string=" " width="0.1"/>
                                            <field name="api_message" optional="hide"/>
                                            <field name="api_state" invisible="1"/>
                                            <button name="action_api_save" string="" type="object" class="btn btn-link text-primary" icon="fa-save mr-1" attrs="{'invisible': [('api_state', '=', True)]}"/>
                                            <button name="action_api_query" string="" type="object" class="btn btn-link text-primary" icon="fa-search mr-1" attrs="{'invisible': [('acc_number', '=', False)]}"/>
                                        </tree>
                                    </field>
                                </group>
                            </group>
                        </sheet>
                    </form>
                </field>
                <button type="action" class="btn-link" name="%(base.action_res_partner_bank_account_form)d" context="{'search_default_partner_id': active_id, 'default_partner_id': active_id, 'form_view_ref': 'account.view_company_partner_bank_form'}" string="View accounts detail" colspan="2"/>
                <field name="payment_item_bank_token_ok" invisible="1"/>
            </group>
        </xpath>
        <xpath expr='//field[@name="parent_id"]' position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr='//notebook' position="replace"/>
    </field>
    </record>

