<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_installment_rate_tree" model="ir.ui.view">
        <field name="name">escrow.installment.rate.tree</field>
        <field name="model">escrow.installment.rate</field>
        <field name="arch" type="xml">
            <tree string="Installment Rates">
                <field name="installment_count"/>
                <field name="rate"/>
                <field name="partner_id"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_installment_rate_form" model="ir.ui.view">
        <field name="name">escrow.installment.rate.form</field>
        <field name="model">escrow.installment.rate</field>
        <field name="arch" type="xml">
            <form string="Installment Rate">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    </div>
                    <group>
                        <group>
                            <field name="installment_count"/>
                            <field name="rate"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_installment_rate_search" model="ir.ui.view">
        <field name="name">escrow.installment.rate.search</field>
        <field name="model">escrow.installment.rate</field>
        <field name="arch" type="xml">
            <search string="Search Installment Rates">
                <field name="installment_count"/>
                <field name="rate"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_by_installment_count" string="Installment Count" context="{'group_by': 'installment_count'}"/>
                    <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_escrow_installment_rate" model="ir.actions.act_window">
        <field name="name">Installment Rates</field>
        <field name="res_model">escrow.installment.rate</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_system': 'escrow'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create an installment rate
            </p>
            <p>
                Define installment rates for different payment plans
            </p>
        </field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_installment_rate_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_installment_rate_form')}),
        ]"/>
    </record>
</odoo>
