    <record id="action_item" model="ir.actions.act_window">
    <field name="name">Collections</field>
    <field name="res_model">payment.item</field>
    <field name="view_mode">tree,pivot,form</field>
    <field name="search_view_id" ref="search_item"/>
    <field name="domain">[('system', '=', 'escrow')]</field>
    <field name="context">{'active_system': 'escrow'}</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
