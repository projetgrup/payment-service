    <field name="context">{'active_system': 'escrow', 'active_escrow_type': 'customer', 'default_system': 'escrow', 'default_escrow_type': 'customer', 'default_is_company': False}</field>
    <field name="search_view_id" ref="search_customer"/>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            Create a customer
