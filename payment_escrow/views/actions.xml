<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_ad" model="ir.actions.act_window">
    <field name="name">Ads</field>
    <field name="res_model">product.product</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="domain">[('system', '=', 'escrow'), ('company_id', '!=', False)]</field>
    <field name="context">{'active_system': 'escrow', 'default_system': 'escrow'}</field>
    <field name="search_view_id" ref="search_ad"/>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            Create an ad
        </p>
    </field>
    <field name="view_ids" eval="[
        (5, 0, 0),
        (0, 0, {'view_mode': 'kanban', 'view_id': ref('kanban_ad')}),
        (0, 0, {'view_mode': 'tree', 'view_id': ref('tree_ad')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('form_ad')}),
    ]"/>
    </record>

