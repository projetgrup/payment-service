<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kanban_ad" model="ir.ui.view">
    <field name="name">product.product.escrow.ad.kanban</field>
    <field name="model">product.product</field>
    <field name="arch" type="xml">
        <kanban sample="1">
            <field name="id"/>
            <field name="currency_id"/>
            <templates>
                <t t-name="kanban-box">
                    <div class="oe_kanban_card oe_kanban_global_click">
                        <div class="o_kanban_image mr-1">
                            <img t-att-src="kanban_image('product.product', 'image_128', record.id.raw_value)" alt="Product" class="o_image_64_contain"/>
                        </div>
                        <div class="oe_kanban_details">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <field name="priority" widget="priority"/>
                            </div>
                            <t t-if="record.default_code.value">[<field name="default_code"/>]</t>
                            <div class="o_kanban_tags_section">
                                <field name="product_template_attribute_value_ids" widget="many2many_tags" options="{'color_field': 'product_attribute_value_color'}"/>
                            </div>
                            <div name="product_owner" class="mt-1">
                                <strong>Owner:</strong>
                                <field name="escrow_owner_id"/>
                            </div>
                            <div name="product_lst_price" class="mt-1" attrs="{'invisible': [('price', '&lt;=', 1.0)]}">
                                <strong>Price:</strong>
                                <field name="price" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                            </div>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
    </record>

    <record id="tree_ad" model="ir.ui.view">
    <field name="name">product.product.escrow.ad.tree</field>
    <field name="model">product.product</field>
    <field name="arch" type="xml">
        <tree string="Ads" create="true" edit="true" delete="true" default_order="priority desc, name asc">
            <field name="escrow_approved_transfer_count" nolabel="1"/>
            <field name="priority" widget="priority" optional="show" nolabel="1"/>
            <field name="name" string="Ad Name" decoration-bf="1"/>
            <field name="default_code" optional="show"/>
            <field name="categ_id" optional="hide"/>
            <field name="uom_id" readonly="1" optional="hide" groups="uom.group_uom"/>
            <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company" optional="hide"/>
            <field name="active" invisible="1"/>
            <field name="currency_id" invisible="1"/>
        </tree>
    </field>
    </record>

    <record id="form_ad" model="ir.ui.view">
    <field name="name">product.product.escrow.ad.form</field>
    <field name="model">product.product</field>
    <field name="arch" type="xml">
        <form>
            <header>
                <field name="escrow_state" widget="statusbar"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_approve_ad"
                        type="object"
                        string="Approve"
                        class="oe_stat_button"
                        icon="fa-check"
                        attrs="{'invisible': ['|', ('system','!=','escrow'), ('escrow_state','!=','waiting')]}"/>
                    <button name="action_get_customer"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-user"
                        attrs="{'invisible': ['|', ('system', '!=', 'escrow'), ('escrow_customer_ids', '=', False)]}">
                        <field name="escrow_customer_count" widget="statinfo" string="Get Customer"/>
                    </button>
                    <button name="action_view_transactions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-credit-card"
                        string="Transactions"
                        attrs="{'invisible': ['|', ('system', '!=', 'escrow'), ('is_platform_owner_user', '=', False)]}"/>
                    <button name="action_approve_transfers"
                        type="object"
                        class="oe_stat_button text-success"
                        icon="fa-exchange"
                        confirm="This will approve ALL wire transfer transactions for this ad. Do you want to continue?"
                        attrs="{'invisible': ['|', ('system', '!=', 'escrow'), ('is_platform_owner_user', '=', False)]}">
                        <field name="escrow_transfer_count_display" widget="statinfo" string="Approve Transfers"/>
                    </button>
                </div>
                <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                <field name="is_product_variant" invisible="1"/>
                <field name="type" invisible="1"/>
                <field name="is_platform_owner_user" invisible="1"/>
                <field name="id" invisible="1"/>
                <field name="active" invisible="1"/>
                <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                <field name="escrow_payment_paid" invisible="1"/>
                <div class="oe_title">
                    <label for="name" string="Ad Name"/>
                    <h1>
                        <div class="d-flex">
                            <field name="priority" widget="priority" class="mr-3"/>
                            <field class="text-break" name="name" placeholder="Type an ad name..."/>
                        </div>
                    </h1>
                </div>
                <group>
                    <group name="group_price">
                        <!--<field name="price" string="Sales Price" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}" attrs="{'invisible': [('payment_price_method', '=', 'formula')], 'readonly': [('payment_price_flow_option', '=', 'dynamic')]}"/>-->
                        <field name="default_code"/>
                        <field name="barcode"/>
                        <field name="lst_price"/>
                    </group>
                    <group name="group_general">
                        <field name="categ_id" string="Category" options="{'no_create': True}"/>
                        <field name="system" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="detailed_type" invisible="1"/>
                        <field name="sale_ok" invisible="1"/>
                        <field name="purchase_ok" invisible="1"/>
                        <field name="product_variant_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" readonly="1"/>
                        <field name="escrow_owner_id" string="Owner"/>
                        <field name="escrow_customer_ids" string="Customers" widget="many2many_tags"/>
                        <field name="escrow_payment_item_id" string="Payment Item"/>
                    </group>
                </group>
                <notebook>
                    <page name="car" string="Car">
                        <group>
                            <group>
                                <field name="escrow_car_brand_id"/>
                                <field name="escrow_car_model_id" domain="[('brand_id','=',escrow_car_brand_id)]"/>
                                <field name="escrow_car_model_year"/>
                                <field name="escrow_car_vin"/>
                                <field name="escrow_car_plate"/>
                            </group>
                            <group>
                                <field name="escrow_ad_sale_img" colspan="2" nolabel="1" widget="image" options="{'preview_image': false}"/>
                                <field name="escrow_ad_official_sale_img" colspan="2" nolabel="1" widget="image" options="{'preview_image': false}"/>
                            </group>
                        </group>
                    </page>
                    <page name="description" string="Description">
                        <field name="description"/>
                    </page>
                </notebook>
            </sheet>
            <div class="oe_chatter">
                <field name="message_follower_ids" widget="mail_followers"/>
                <field name="activity_ids" widget="mail_activity"/>
                <field name="message_ids" widget="mail_thread"/>
            </div>
            </form>
    </field>
    </record>

    <record id="search_ad" model="ir.ui.view">
    <field name="name">product.product.escrow.ad.search</field>
    <field name="model">product.product</field>
    <field name="arch" type="xml">
        <search>
            <field name="name"/>
            <field name="company_id" groups="base.group_multi_company,base.group_system"/>
            <filter name="favorite" string="Favorites" domain="[('priority', '=', '1')]"/>
            <group expand="0" string="Groupby">
                <filter string="Company" name="groupby_company" domain="[]" context="{'group_by':'company_id'}" groups="base.group_multi_company,base.group_system"/>
            </group>
        </search>
    </field>
    </record>
</odoo>
