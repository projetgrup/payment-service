<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="recipient_corporate" name="Recipient Corporate Section">
        <div class="form__group">
            <label class="form__label" for="recipient_corporate_title">Company Title</label>
            <input class="form__control -letter" name="recipient_corporate_title" id="recipient_corporate_title" type="text" placeholder="Company Title" value="" field="customer.input.corporate_title"/>
        </div>
        <div class="form__group">
            <label class="form__label" for="recipient_tax_number">Tax Number</label>
            <input class="form__control -letter" name="recipient_tax_number" id="recipient_tax_number" type="text" placeholder="Tax Number" value="" field="customer.input.tax_number"/>
        </div>
        <div class="form__group">
            <label class="form__label" for="recipient_tax_office">Tax Office</label>
            <input class="form__control -letter" name="recipient_tax_office" id="recipient_tax_office" type="text" placeholder="Tax Office" value="" field="customer.input.tax_office"/>
        </div>
        <div class="form__group">
            <label class="form__label" for="recipient_address_corporate">Address</label>
            <textarea class="form__control -letter" name="recipient_address" id="recipient_address_corporate" placeholder="Address" field="customer.input.address_corporate"></textarea>
        </div>
        <div class="form__group">
            <label class="form__label" for="recipient_person">Authorized Person</label>
            <input class="form__control -letter" name="recipient_person" id="recipient_person" type="text" placeholder="Authorized Person" value="" field="customer.input.person"/>
        </div>
        <div class="form__group">
            <label class="form__label" for="recipient_phone_corporate">Authorized Mobile Phone</label>
            <input class="form__control -letter" name="recipient_phone" id="recipient_phone_corporate" type="text" placeholder="e.g: 532 123 3456" value="" field="customer.input.phone_corporate"/>
        </div>
        <div class="form__group">
            <label class="form__label" for="recipient_email_corporate">Authorized Email</label>
            <input class="form__control -letter" name="recipient_email" id="recipient_email_corporate" type="email" placeholder="example@mail.com" value="" field="customer.input.email_corporate"/>
        </div>
    </template>

    <template id="recipient_individual" name="Recipient Individual Section">
        <div class="form__group">
            <label class="form__label" for="recipient_name_surname">Full Name</label>
            <input class="form__control -letter" name="recipient_name_surname" id="recipient_name_surname" type="text" placeholder="Full Name" value="" field="customer.input.name_surname"/>
        </div>
        <div class="form__group">
            <label class="form__label" for="recipient_identity">Identity Number</label>
            <input class="form__control -letter" name="recipient_identity" id="recipient_identity" type="text" placeholder="T.C. Kimlik Numarası" value="" field="customer.input.identity"/>
        </div>
        <div class="form__group">
            <label class="form__label" for="recipient_phone_individual">Phone Number</label>
            <input class="form__control -letter" name="recipient_phone" id="recipient_phone_individual" type="text" placeholder="Örn: 532 123 3456" value="" field="customer.input.phone_individual"/>
        </div>
        <div class="form__group">
            <label class="form__label" for="recipient_email_individual">E-mail</label>
            <input class="form__control -letter" name="recipient_email" id="recipient_email_individual" type="email" placeholder="ornek@mail.com" value="" field="customer.input.email_individual"/>
        </div>
        <div class="form__group">
            <label class="form__label" for="recipient_address_individual">Address</label>
            <textarea class="form__control -letter" name="recipient_address" id="recipient_address_individual" placeholder="Address" field="customer.input.address_individual"></textarea>
        </div>
    </template>
</odoo>