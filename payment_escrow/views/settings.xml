<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="settings_form" model="ir.ui.view">
    <field name="name">payment.settings.escrow.form</field>
    <field name="model">payment.settings</field>
    <field name="inherit_id" ref="payment_jetcheckout_system.settings_form"/>
    <field name="arch" type="xml">
        <xpath expr="//div[@data-key='general_settings']" position="after">
            <div class="app_settings_block" data-string="Escrows" string="Escrows" data-key="payment_escrow" invisible="context.get('active_system') != 'escrow'">
                <h2>Escrows</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="system_agreement"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="system_agreement"/>
                            <div class="text-muted">
                                Define agreements to facilitate receiving payments
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="system_product"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="system_product"/>
                            <div class="text-muted">
                                Define products to facilitate receiving payments
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="payment_page_amount_editable"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="payment_page_amount_editable" string="Editable Payment Amount"/>
                            <div class="text-muted">
                                Allow partners to edit payable amount on payment link
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="payment_page_amount_editable_wo_exceed" class="mx-2"/>
                                    <label for="payment_page_amount_editable_wo_exceed" class="o_light_label" string="Disallow to exceed amount"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="payment_page_button_access_transaction"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="payment_page_button_access_transaction" string="Access All Transactions"/>
                            <div class="text-muted">
                                Allow partners to see their all transactions on payment link
                            </div>
                        </div>
                    </div>


                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="conveyance_show_link"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="conveyance_show_link" string="Conveyance Document"/>
                            <div class="text-muted">
                                Show Conveyance Document
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="broker_registration_enabled"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="broker_registration_enabled" string="Broker Registration"/>
                            <div class="text-muted">
                                Enable Broker Registration
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="dealer_registration_enabled"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="dealer_registration_enabled" string="Dealer Registration"/>
                            <div class="text-muted">
                                Enable Dealer Registration
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="escrow_insurance_quote_enabled"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="escrow_insurance_quote_enabled" string="Escrow Insurance Quote"/>
                            <div class="text-muted">
                                Enable Escrow Insurance Quote
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </field>
    </record>
</odoo>
