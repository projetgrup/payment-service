<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_broker_campaign_tree" model="ir.ui.view">
        <field name="name">escrow.broker.campaign.tree</field>
        <field name="model">escrow.broker.campaign</field>
        <field name="arch" type="xml">
            <tree string="Broker Campaigns">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="create_date"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_broker_campaign_form" model="ir.ui.view">
        <field name="name">escrow.broker.campaign.form</field>
        <field name="model">escrow.broker.campaign</field>
        <field name="arch" type="xml">
            <form string="Broker Campaign">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="create_date" readonly="1"/>
                            <field name="create_uid" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Installment Rates" name="installment_rates">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="installment_count"/>
                                    <field name="broker_additional_rate"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_broker_campaign_search" model="ir.ui.view">
        <field name="name">escrow.broker.campaign.search</field>
        <field name="model">escrow.broker.campaign</field>
        <field name="arch" type="xml">
            <search string="Search Broker Campaigns">
                <field name="name"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_broker_campaign" model="ir.actions.act_window">
        <field name="name">Broker Campaigns</field>
        <field name="res_model">escrow.broker.campaign</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_system': 'escrow'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a broker campaign
            </p>
            <p>
                Define commission campaigns with additional rates for different installment counts
            </p>
        </field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_broker_campaign_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_broker_campaign_form')}),
        ]"/>
    </record>
</odoo>
