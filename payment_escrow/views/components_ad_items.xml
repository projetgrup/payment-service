<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ad_list_item" name="Ad List Item">
        <div class="escrow-ad-list-item escrow-item" t-att-data-id="ad.id" t-att-data-product-id="ad.id" t-att-data-item-id="ad.escrow_payment_item_id.id" t-att-data-item-amount="ad.escrow_payment_item_id.amount" t-att-data-item-residual-amount="ad.escrow_payment_item_id.residual_amount" t-att-data-item-paid-amount="ad.escrow_payment_item_id.paid_amount" t-att-data-name="ad.name" t-att-data-amount="ad.list_price or 0" t-att-data-quantity="1" t-att-data-description="ad.name" data-value="" field="ad.item" t-att-data-vin="ad.escrow_car_vin or ''" t-att-data-plate="ad.escrow_car_plate or ''" t-att-data-brand-id="ad.escrow_car_brand_id.id" t-att-data-brand-name="ad.escrow_car_brand_id.name or ''" t-att-data-category-name="ad.categ_id.name or ''" t-att-data-model-id="ad.escrow_car_model_id.id" t-att-data-model-name="ad.escrow_car_model_id.name or ''" t-att-data-owner-id="ad.escrow_owner_id.id" t-att-data-customer-id="ad.escrow_customer_id.id" t-att-data-model-year="ad.escrow_car_model_year">
            <div class="escrow-ad-item-info">
                <div class="escrow-ad-item-image">
                    <img t-attf-src="data:image/png;base64,#{ad.image_1920}" alt="" name="img"/>
                </div>
                <span class="escrow-ad-item-name" t-esc="ad.name" name="name"/>
            </div>
            <div class="escrow-ad-item-categ" t-esc="ad.categ_id.name" t-att-data-id="ad.categ_id.id" name="categ"/>
            <div class="escrow-ad-item-price" t-esc="ad.escrow_payment_item_id.amount" t-options="{'widget': 'monetary', 'display_currency': ad.currency_id}" t-att-data-value="ad.price" name="price"/>
            <div class="escrow-ad-item-state">
                <span class="success">New</span>
            </div>
            <div class="escrow-ad-item-arrow">
                <i class="fa fa-chevron-right"/>
            </div>
        </div>
    </template>

    <template id="ad_grid_item" name="Ad Grid Item">
        <div class="escrow-ad-grid-item escrow-item" t-att-data-id="ad.id" t-att-data-product-id="ad.id" t-att-data-item-id="ad.escrow_payment_item_id.id" t-att-data-item-amount="ad.escrow_payment_item_id.amount" t-att-data-item-residual-amount="ad.escrow_payment_item_id.residual_amount" t-att-data-item-paid-amount="ad.escrow_payment_item_id.paid_amount" t-att-data-name="ad.name" t-att-data-amount="ad.list_price or 0" t-att-data-quantity="1" t-att-data-description="ad.name" field="ad.item" t-att-data-vin="ad.escrow_car_vin or ''" t-att-data-plate="ad.escrow_car_plate or ''" t-att-data-brand-id="ad.escrow_car_brand_id.id" t-att-data-brand-name="ad.escrow_car_brand_id.name or ''" t-att-data-model-id="ad.escrow_car_model_id.id" t-att-data-model-name="ad.escrow_car_model_id.name or ''" t-att-data-owner-id="ad.escrow_owner_id.id" t-att-data-customer-id="ad.escrow_customer_id.id" t-att-data-model-year="ad.escrow_car_model_year" t-att-data-category-name="ad.categ_id.name or ''">
            <div class="escrow-ad-grid-item-header">
                <div class="escrow-ad-figure">
                    <img t-attf-src="data:image/png;base64,#{ad.image_1920}" alt="" name="img"/>
                </div>
                <span t-esc="ad.name" name="name"/>
            </div>
            <div class="escrow-ad-grid-item-body">
                <div class="escrow-ad-grid-item-categ" t-esc="ad.categ_id.name" name="categ"/>
                <div class="escrow-ad-grid-item-price" t-esc="ad.price" t-options="{'widget': 'monetary', 'display_currency': ad.currency_id}" name="price"/>
                <div class="escrow-ad-grid-item-status">
                    <span class="success">New</span>
                </div>
            </div>
        </div>
    </template>
</odoo>