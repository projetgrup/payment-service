<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ad_list_item" name="Ad List Item">
        <div class="escrow-ad-list-item escrow-item" t-att-data-id="ad.id" t-att-data-value="json.dumps({
                'id': ad.id,
                'product_id': ad.id,
                'item_id': ad.escrow_payment_item_id.id,
                'amount': ad.escrow_payment_item_id.amount,
                'residual_amount': ad.escrow_payment_item_id.residual_amount,
                'paid_amount': ad.escrow_payment_item_id.paid_amount,
                'name': ad.name,
                'amount': ad.list_price or 0,
                'quantity': 1,
                'description': ad.name,
                'vin': ad.escrow_car_vin or '',
                'plate': ad.escrow_car_plate or '',
                'brand_id': ad.escrow_car_brand_id.id,
                'brand_name': ad.escrow_car_brand_id.name or '',
                'category_name': ad.categ_id.name or '',
                'model_id': ad.escrow_car_model_id.id,
                'model_name': ad.escrow_car_model_id.name or '',
                'owner_id': ad.escrow_owner_id.id,
                'year': ad.escrow_car_model_year,
                'categ': ad.categ_id.id,
                'partner': ad.escrow_payment_item_id.parent_id.name,
                'vat': ad.escrow_payment_item_id.parent_id.vat,
                'iban': ad.escrow_payment_item_id.parent_id.bank_ids and ad.escrow_payment_item_id.parent_id.bank_ids[0]['acc_number'] or '',
            })" field="ad.item" t-att-data-item-id="ad.escrow_payment_item_id.id" t-att-data-product-id="ad.id">
            <div class="escrow-ad-item-info">
                <div class="escrow-ad-item-image">
                    <img t-attf-src="data:image/png;base64,#{ad.image_1920}" alt="" name="img"/>
                </div>
                <span class="escrow-ad-item-name" t-esc="ad.name" name="name"/>
            </div>
            <div class="escrow-ad-item-categ" t-esc="ad.categ_id.name" t-att-data-id="ad.categ_id.id" name="categ"/>
            <div class="escrow-ad-item-price" t-esc="ad.escrow_payment_item_id.amount" t-options="{'widget': 'monetary', 'display_currency': ad.currency_id}" t-att-data-value="ad.price" name="price"/>
            <div class="escrow-ad-item-state">
                <span class="success">New</span>
            </div>
            <div class="escrow-ad-item-arrow">
                <i class="fa fa-chevron-right"/>
            </div>
        </div>
    </template>

    <template id="ad_grid_item" name="Ad Grid Item">
        <div class="escrow-ad-grid-item escrow-item" t-att-data-id="ad.id" field="ad.item">
            <div class="escrow-ad-grid-item-header">
                <div class="escrow-ad-figure">
                    <img t-attf-src="data:image/png;base64,#{ad.image_1920}" alt="" name="img"/>
                </div>
                <span t-esc="ad.name" name="name"/>
            </div>
            <div class="escrow-ad-grid-item-body">
                <div class="escrow-ad-grid-item-categ" t-esc="ad.categ_id.name" name="categ"/>
                <div class="escrow-ad-grid-item-price" t-esc="ad.price" t-options="{'widget': 'monetary', 'display_currency': ad.currency_id}" name="price"/>
                <div class="escrow-ad-grid-item-status">
                    <span class="success">New</span>
                </div>
            </div>
        </div>
    </template>
</odoo>
