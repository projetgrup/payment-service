                                fill="#1C274C"></path>
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="escrow-ad-container">
                    <div class="row justify-content-md-center">
                        <div class="escrow-ad-read col-12">
                            <div class="escrow-ad-nav">
                                <h3 class="escrow-ad-nav-title">My Ads</h3>
                                <div class="escrow-ad-nav-control">
                                    <button class="btn escrow-ad-nav-button-primary" title="Add New Ad" data-view="form" field="ad.button.form"><i class="fa fa-plus mr8"/>Add New Ad</button>
                                    <div class="escrow-ad-nav-buttons">
                                        <button class="btn escrow-ad-nav-button-secondary active" data-view="list" field="ad.button.list">List</button>
                                        <button class="btn escrow-ad-nav-button-secondary" data-view="grid" field="ad.button.grid">Grid</button>
                                    </div>
                                </div>
                            </div>
                            <div class="escrow-ad-list list-view" field="ad.view.list">
                                <div class="escrow-ad-list-header">
                                    <div>AD NAME</div>
                                    <div>CATEGORY</div>
                                    <div>PRICE</div>
                                    <div>STATE</div>
                                    <div/>
                                </div>
                                <t t-foreach="ads" t-as="ad">
                                    <div class="escrow-ad-list-row" t-att-data-id="ad.id" data-value="" field="ad.item">
                                        <div class="escrow-ad-item-info">
                                            <div class="escrow-ad-item-image">
                                                <img t-attf-src="data:image/png;base64,#{ad.image_1920}" alt=""/>
                                            </div>
                                            <span class="escrow-ad-item-name" t-esc="ad.name"/>
                                        </div>
                                        <div class="escrow-ad-item-categ" t-esc="ad.categ_id.name" t-att-data-id="ad.categ_id.id"/>
                                        <div class="escrow-ad-item-price" t-esc="ad.price" t-options="{'widget': 'monetary', 'display_currency': ad.currency_id}"/>
                                        <div class="escrow-ad-item-state"><span class="danger">Satıldı</span></div>
                                        <div class="escrow-ad-item-arrow"><i class="fa fa-chevron-right"/></div>
                                        <div class="escrow-ad-item-desc d-none" t-raw="ad.description"/>
                                    </div>
                                </t>
                            </div>
                            <div class="escrow-ad-grid grid-view" field="ad.view.grid">
                                <div class="escrow-ad-grid-container">
                                    <t t-foreach="ads" t-as="ad">
                                        <div class="escrow-ad-grid-cell" t-att-data-id="ad.id" field="ad.item">
                                            <div class="escrow-ad-grid-cell-header">
                                                <div class="escrow-ad-figure">
                                                    <img t-attf-src="data:image/png;base64,#{ad.image_1920}" alt=""/>
                                                </div>
                                                <span t-esc="ad.name"/>
                                            </div>
                                            <div class="escrow-ad-grid-cell-body">
                                                <div class="escrow-ad-grid-cell-body-categ" t-esc="ad.categ_id.name"/>
                                                <div class="escrow-ad-grid-cell-body-price" t-esc="ad.price" t-options="{'widget': 'monetary', 'display_currency': ad.currency_id}"/>
                                                <div class="escrow-ad-grid-cell-body-status"><span class="danger">Satıldı</span></div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                        <div class="escrow-ad-edit col-12">
                            <div class="escrow-ad-nav">
                                <h3 class="escrow-ad-nav-title"></h3>
                                <div class="escrow-ad-nav-control">
                                    <button class="btn escrow-ad-nav-button-primary" title="Add New Ad" data-view="form" field="ad.button.save"><i class="fa fa-save mr8"/>Save</button>
                                    <button class="btn escrow-ad-nav-button-secondary" data-view="list" field="ad.button.discard">Discard</button>
                                </div>
                            </div>
                            <div class="escrow-ad-form form-view" field="ad.view.form">
                                <div class="escrow-ad-form-container">
                                    <div class="field-container field-name">
                                        <input id="adInputName" type="text" class="text-center" required="required" field="ad.input.name"/>
                                        <span class="bar-container"/>
                                        <label for="adInputName"><span>Name</span></label>
                                    </div>
                                    <div class="field-container field-categ">
                                        <select required="required" field="ad.input.categ" placeholder="Select a category">
                                            <option/>
                                            <t t-foreach="company.env['product.category'].sudo().with_context(system='escrow').search_read([('company_id', '=', company.id)])" t-as="categ">
                                                <option t-att-value="categ['id']" t-esc="categ['name']"/>
                                            </t>
                                        </select>
                                        <span class="bar-container"/>
                                        <label for="adInputCateg"><span>Category</span></label>
                                    </div>
                                    <div class="field-img">
                                        <input type="file" class="filepond" name="filepond" accept="image/png, image/jpeg, image/gif" field="ad.input.img"/>
                                    </div>
                                    <div class="field-container field-price">
                                        <input id="adInputPrice" type="text" inputmode="decimal" required="required" field="ad.input.price" t-att-placeholder="language.format('%.{0}f'.format(currency.decimal_places), 0, grouping=True, monetary=True)" class="text-center"/>
                                        <span class="bar-container"/>
                                        <span t-if="currency.position == 'before'" class="symbol symbol-before" t-esc="currency.symbol"/>
                                        <span t-else="" class="symbol symbol-after" t-esc="currency.symbol"/>
                                        <label for="adInputPrice"><span>Price</span></label>
                                    </div>
                                    <div class="field-container field-desc">
                                        <textarea id="adInputDesc" style="min-height: 120px" class="form-control o_wysiwyg_loader" required="required" field="ad.input.desc"/>
                                        <span class="bar-container"/>
                                        <label for="adInputDesc"><span>Description</span></label>
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="escrow-ad-edit col-12">
                        </div>
                    </div>
                </div>
            </div>
            <div class="escrow-ad-sideback d-none" field="ad.sideback"/>
            <div class="escrow-ad-sidebar" field="ad.sidebar">
                <button class="btn" field="ad.button.sidebar.toggle"><i class="fa fa-2x fa-times"/></button>
                <div class="escrow-ad-sidebar-section escrow-ad-sidebar-settings d-none">
                    <div class="escrow-ad-sidebar-settings-theme my-4">
                        <div>
                            <strong>View Settings</strong>
                            <p>You can change the application theme here.</p>
                        </div>
                        <div>
                            <div>
                                <button class="btn" data-value="light" field="ad.button.sidebar.theme">Light</button>
                                <button class="btn" data-value="dark" field="ad.button.sidebar.theme">Dark</button>
                                <button class="btn active" data-value="system" field="ad.button.sidebar.theme">System</button>
                            </div>
                        </div>
                    </div>
                    <div class="escrow-ad-sidebar-settings-lang my-4">
                        <div>
                            <strong>Application Language</strong>
                            <p>You can set the language settings here.</p>
                        </div>
                        <div>
                            <div>
