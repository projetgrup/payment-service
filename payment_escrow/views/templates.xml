<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="page_payment" name="Escrow Payment Page">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <t t-set="class" t-value="True"/>
            <t t-set="title" t-value="website.name"/>
            <t t-set="body_classname" t-value="'payment-page payment-api-page payment-escrow navbar-light'"/>
            <t t-set="x_icon" t-value="'/web/image?model=website&amp;id=%s&amp;field=favicon' % website.id"/>
            <t t-call="payment_escrow.background_animation"/>

            <div class="escrow-ad-wrapper">
                <t t-call="payment_escrow.header">
                    <t t-set="variant" t-value="'payment'"/>
                    <t t-set="company" t-value="tx.company_id"/>
                </t>

                <!-- Payment Steps - Using Template Component -->
                <t t-call="payment_escrow.steps_container_template">
                    <t t-set="container_class" t-value="'d-none'"/>
                    <t t-set="container_id" t-value="'payment-steps'"/>
                    <t t-set="step_1_class" t-value="'-completed'"/>
                    <t t-set="step_1_edit" t-value="True"/>
                    <t t-set="step_2_class" t-value="'-completed'"/>
                    <t t-set="step_3_class" t-value="'-completed'"/>
                    <t t-set="step_3_edit" t-value="True"/>
                    <t t-set="step_4_class" t-value="'-active'"/>
                </t>
                <div class="px-lg-5 mx-xl-auto mw-xl-128">
                    <t t-call="payment_jetcheckout_system.payment_state">
                        <t t-set="classes" t-value="'mx-0'"/>
                        <t t-set="hide_button_payment" t-value="True"/>
                        <t t-set="hide_report_iframe" t-value="True"/>
                    </t>
                    <div class="row mx-0 my-4 card border shadow p-4">
                        <div class="text-center text-primary h5 font-weight-bold position-relative">
                            <a t-if="not tx_pending and back_url" class="btn card d-block ml-3 position-absolute shadow-sm text-600" t-att-href="back_url">
                                <i class="fa fa-arrow-left text-primary mr-3" t-translations="off"/>
                                Back
                            </a>
                        Payment Information
                        </div>
                        <div class="row mx-0 my-2">
                            <div class="col-md-6 p-3">
                                <div class="border card info-card p-4 h-100">
                                    <div class="position-absolute info-icon">
                                        <i class="fa fa-info"/>
                                    </div>
                                    <div>
                                        <strong class="text-primary font-weight-bold">Customer</strong>
                                        <p class="mr-5 pr-5">
                                            <t t-esc="tx.partner_name"/>
                                            <br/>
                                            <t t-esc="tx.partner_address"/>
                                            <t t-if="tx.partner_state_id">
                                                <t t-esc="tx.partner_state_id.name"/>
                                                <t t-esc="tx.partner_country_id.name"/>
                                            </t>
                                            <t t-else="">
                                                <t t-esc="tx.partner_country_id.name"/>
                                            </t>
                                        </p>
                                    </div>
                                    <div t-if="tx.jetcheckout_api_contact">
                                        <strong class="text-primary font-weight-bold">Contact</strong>
                                        <p>
                                            <t t-esc="tx.jetcheckout_api_contact"/>
                                            <br/>
                                            <t t-esc="tx.partner_email"/>
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 p-3">
                                <div class="border card info-card p-4 h-100">
                                    <div class="position-absolute info-icon">
                                        <i class="fa fa-shopping-basket"/>
                                    </div>
                                    <div t-if="len(tx.paylox_product_ids) == 1 and tx.paylox_product_ids[0]['qty'] &lt;= 1.0">
                                        <strong class="text-primary font-weight-bold z-index-1">Product</strong>
                                        <p class="z-index-1">
                                            <t t-esc="tx.paylox_product_ids[0]['product_id']['name']"/>
                                        </p>
                                    </div>
                                    <div t-elif="tx.jetcheckout_api_order">
                                        <strong class="text-primary font-weight-bold z-index-1">Reference</strong>
                                        <p class="z-index-1">
                                            <t t-esc="tx.jetcheckout_api_order"/>
                                        </p>
                                    </div>
                                    <div>
                                        <p class="text-right mt-3 mb-0">
                                            <strong class="text-primary font-weight-bold text-right z-index-1 mt-5">Amount</strong>
                                        </p>
                                        <p class="h3 text-right font-weight-bold z-index-1">
                                            <t t-esc="tx.amount" t-options="{'widget': 'monetary', 'display_currency': tx.currency_id}"/>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div t-if="tx.paylox_product_ids" class="row mx-0 my-2 px-3">
                            <div class="card table-responsive">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th class="text-right">Price</th>
                                            <!--<th class="text-right">Quantity</th>
                                        <th></th>
                                        <th class="text-right">Total</th>-->
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="tx.paylox_product_ids" t-as="product">
                                            <tr>
                                                <td>
                                                    <span t-esc="product.product_id.name"/>
                                                </td>
                                                <td class="text-right">
                                                    <span t-esc="product.price" t-options="{'widget': 'monetary', 'display_currency': tx.currency_id}"/>
                                                </td>
                                                <!--<td class="text-right"><span t-esc="product.qty" t-options="{'widget': 'float', 'precision': 2}"/></td>
                                            <td><span t-esc="product.uom or ''"/></td>
                                            <td class="text-right"><span t-esc="product.price * product.qty" t-options="{'widget': 'monetary', 'display_currency': tx.currency_id}"/></td>-->
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="page_ads" name="Ads Page">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <t t-set="s2s" t-value="True"/>
            <t t-set="class" t-value="True"/>
            <t t-set="title" t-value="website.name"/>
            <t t-set="body_classname" t-value="'payment-page payment-escrow'"/>
            <t t-set="language" t-value="request.env['res.lang']._lang_get(request.env.lang)"/>
            <t t-set="x_icon" t-value="'/web/image?model=website&amp;id=%s&amp;field=favicon' % website.id"/>
            <t t-call="payment_jetcheckout.payment_loading"/>
            <t t-call="payment_escrow.background_animation"/>
            <div class="escrow-ad-wrapper">
                <t t-call="payment_escrow.header">
                    <t t-set="variant" t-value="'ads'"/>
                    <t t-set="company" t-value="company"/>
                </t>
                <div class="escrow-ad-container">
                    <div class="col-12 col-lg-8 mx-auto p-2 escrow-ad-dashboard" style="display:none" field="seller.ads">
                        <div class="col-12">
                            <div class="escrow-ad-nav">
                                <h3 class="escrow-ad-nav-title">My Ads</h3>
                                <div class="escrow-ad-nav-control">
                                    <button type="button" 
                                            class="btn escrow-ad-nav-button-primary mr-1"
                                            data-toggle="modal" 
                                            data-target="#insuranceQuoteModal"
                                            t-if="request.env.company.escrow_insurance_quote_enabled"
                                            field="insurance.button.open">
                                        <i class="fa fa-shield-alt mr8"/>
                                        Request Insurance Quote
                                    </button>
                                    <a class="btn escrow-ad-nav-button-primary mr-1" t-if="request.env.user.payment_preview_ok" data-view="form" target="_blank" href="/my/broker/rates">
                                        <i class="fa fa-plus mr8"/>
                                        Calculation Module
                                    </a>
                                    <button class="btn escrow-ad-nav-button-primary" data-view="form" field="ad.button.create">
                                        <i class="fa fa-plus mr8"/>
                                        Receive Payment
                                    </button>
                                    <div class="escrow-ad-nav-buttons">
                                        <button class="btn escrow-ad-nav-button-secondary active" data-view="list" field="ad.button.list">List</button>
                                        <button class="btn escrow-ad-nav-button-secondary" data-view="grid" field="ad.button.grid">Grid</button>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Filters and Sorting -->
                            <div class="col-12 mb-4">
                                <div class="card border-0 shadow-sm" style="border-radius: 12px;">
                                    <div class="card-body py-3 px-4">
                                        <div class="row align-items-center">
                                            <!-- State Filter Tags -->
                                            <div class="col-lg-8 mb-2 mb-lg-0">
                                                <div class="d-flex align-items-center flex-wrap">
                                                    <span class="mr-3 font-weight-600 text-dark" style="font-size: 14px;">Filter by Status:</span>
                                                    <div class="btn-group btn-group-toggle" role="group" field="ad.state.filter">
                                                        <button type="button" class="btn btn-secondary filter-btn active" data-state="all" field="ad.state.all">
                                                            <i class="fa fa-list mr-1"></i>All
                                                        </button>
                                                        <button type="button" class="btn btn-outline-success filter-btn" data-state="new" field="ad.state.new">
                                                            <i class="fa fa-plus-circle mr-1"></i>New
                                                        </button>
                                                        <button type="button" class="btn btn-outline-warning filter-btn" data-state="waiting" field="ad.state.waiting">
                                                            <i class="fa fa-clock-o mr-1"></i>Waiting
                                                        </button>
                                                        <button type="button" class="btn btn-outline-info filter-btn" data-state="waiting_official_sale_img" field="ad.state.waiting_sale">
                                                            <i class="fa fa-image mr-1"></i>Pending Sale
                                                        </button>
                                                        <button type="button" class="btn btn-outline-info filter-btn" data-state="waiting_transfer_approval" field="ad.state.waiting_transfer_approval">
                                                            <i class="fa fa-check-circle mr-1"></i>Pending Transfer Approval
                                                        </button>
                                                        <button type="button" class="btn filter-btn" data-state="transferred" field="ad.state.transferred">
                                                            <i class="fa fa-check-circle mr-1"></i>Transferred
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <!-- Sorting -->
                                            <!-- <div class="col-lg-4">
                                                <div class="d-flex align-items-center justify-content-lg-end">
                                                    <span class="mr-2 font-weight-600 text-dark" style="font-size: 14px;">Sort:</span>
                                                    <select class="form-control" style="width: 200px; border-radius: 8px;" field="ad.sort">
                                                        <option value="date_desc">📅 Newest First</option>
                                                        <option value="date_asc">📅 Oldest First</option>
                                                        <option value="price_asc">💰 Price: Low to High</option>
                                                        <option value="price_desc">💰 Price: High to Low</option>
                                                        <option value="name_asc">🔤 Name: A to Z</option>
                                                        <option value="name_desc">🔤 Name: Z to A</option>
                                                    </select>
                                                </div>
                                            </div> -->
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="escrow-ad-list list-view" field="ad.view.list">
                                <div class="escrow-ad-list-header">
                                    <div>AD NAME</div>
                                    <div>CATEGORY</div>
                                    <div>PRICE</div>
                                    <div>STATE</div>
                                    <div/>
                                </div>
                                <div class="ad-list-container w-100" field="ad.list.container">
                                    <t t-foreach="ads" t-as="ad">
                                        <t t-call="payment_escrow.ad_list_item"/>
                                    </t>
                                </div>
                            </div>
                            <div class="escrow-ad-grid grid-view" field="ad.view.grid">
                                <div class="escrow-ad-grid-container" field="ad.grid.container">
                                    <t t-foreach="ads" t-as="ad">
                                        <t t-call="payment_escrow.ad_grid_item"/>
                                    </t>
                                </div>
                            </div>
                            
                            <!-- Pagination Controls -->
                            <div class="d-flex justify-content-between align-items-center mt-4 mb-3" field="ad.pagination.container">
                                <div class="pagination-info">
                                    <span class="text-muted">Showing <span field="ad.pagination.showing">1-10</span> of <span field="ad.pagination.total">0</span> ads</span>
                                </div>
                                <nav aria-label="Pagination Navigation">
                                    <ul class="pagination pagination-sm mb-0">
                                        <li class="page-item" field="ad.pagination.prev">
                                            <a class="page-link" href="#" aria-label="Previous">
                                                <i class="fa fa-chevron-left"></i>
                                            </a>
                                        </li>
                                        <li class="page-item active">
                                            <span class="page-link" field="ad.pagination.current">1</span>
                                        </li>
                                        <li class="page-item" field="ad.pagination.next">
                                            <a class="page-link" href="#" aria-label="Next">
                                                <i class="fa fa-chevron-right"></i>
                                            </a>
                                        </li>
                                    </ul>
                                </nav>
                                <div class="pagination-size">
                                    <select class="form-select form-select-sm" field="ad.pagination.size" style="width: auto;">
                                        <option value="10">10 per page</option>
                                        <option value="20">20 per page</option>
                                        <option value="50">50 per page</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="escrow-wizard" field="seller.wizard" style="display:none">
                        <div class="row mx-0 w-100 position-relative">
                            <!-- Close Button -->
                            <button type="button" class="btn-close wizard-close-btn position-absolute px-3 py-2" 
                                style="top: 15px; left: 15px; background: rgba(255,255,255,0.9); z-index: 1; border: 1px solid #ddd; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(0,0,0,0.15);" 
                                field="seller.button.close" 
                                title="Close Wizard">
                                    <i class="fa fa-chevron-left mr8" style="color: #666; font-size: 16px;"/>
                                    <span>Back</span>
                            </button>
                            
                            <div class="col-12 col-lg-8 col-xl-6 mx-auto p-2 d-flex justify-content-center pt-5 p-sm-0 position-static">

                                <div class="wizard-loading fade" field="wizard.loading">
                                </div>

                                <div class="wizard-step wizard-step-1" style="display:none">
                                    <t t-call="payment_escrow.step_1_content"/>
                                </div>

                                <div class="wizard-step wizard-step-2" style="display:none">
                                    <t t-call="payment_escrow.step_2_content"/>
                                </div>

                                <div class="wizard-step wizard-step-3" style="display:none">
                                    <t t-call="payment_escrow.step_3_content"/>
                                </div>

                                <div class="wizard-step wizard-step-4" style="display:none">
                                    <t t-call="payment_escrow.step_4_content"/>
                                </div>

                                <div class="wizard-step wizard-step-5" style="display:none">
                                    <t t-call="payment_escrow.step_5_content"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <t t-call="payment_escrow.insurance_quote_modal"/>
            
            <div class="escrow-ad-sideback d-none" field="ad.sideback"/>
            <div class="escrow-ad-sidebar" field="ad.sidebar">
                <button class="btn" field="ad.button.sidebar.toggle">
                    <i class="fa fa-2x fa-times"/>
                </button>
                <div class="escrow-ad-sidebar-section escrow-ad-sidebar-settings d-none">
                    <div class="escrow-ad-sidebar-settings-theme my-4">
                        <div>
                            <strong>View Settings</strong>
                            <p>You can change the application theme here.</p>
                        </div>
                        <div>
                            <div>
                                <button class="btn" data-value="light" field="ad.button.sidebar.theme">Light</button>
                                <button class="btn" data-value="dark" field="ad.button.sidebar.theme">Dark</button>
                                <button class="btn active" data-value="system" field="ad.button.sidebar.theme">System</button>
                            </div>
                        </div>
                    </div>
                    <div class="escrow-ad-sidebar-settings-lang my-4">
                        <div>
                            <strong>Application Language</strong>
                            <p>You can set the language settings here.</p>
                        </div>
                        <div>
                            <div>
                                <button class="btn active" data-value="tr" field="ad.button.sidebar.lang">Turkish</button>
                                <button class="btn" data-value="en" field="ad.button.sidebar.theme.lang">English</button>
                            </div>
                        </div>
                    </div>
                    <div class="escrow-ad-sidebar-settings-help my-4">
                        <div>
                            <strong>Helpdesk</strong>
                            <p>You can get support 7/24 by contacting us.</p>
                        </div>
                        <button class="btn btn-block text-left">
                            <i class="fa fa-question pr-2"/>
                            <span>Get Help</span>
                        </button>
                        <button class="btn btn-block text-left">
                            <i class="fa fa-life-bouy pr-2"/>
                            <span>Request Support</span>
                        </button>
                        <button class="btn btn-block text-left">
                            <i class="fa fa-phone pr-2"/>
                            <span>Contact with Us</span>
                        </button>
                    </div>
                </div>
                <div class="escrow-ad-sidebar-section escrow-ad-sidebar-items d-none">
                    <div class="h3 p-2">Ad Details</div>

                    <div class="info-card seller-info-card" data-action="edit-seller" field="edit.seller.holder">
                        <div class="info-card-header">
                            <i class="fa fa-user"></i>
                            <h4>Seller Information</h4>
                        </div>
                        <div class="info-card-content">
                            <div class="info-item">
                                <span class="info-label">Name Surname:</span>
                                <span class="info-value seller-name"></span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">TCKN:</span>
                                <span class="info-value seller-tc"></span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">IBAN:</span>
                                <span class="info-value seller-iban"></span>
                            </div>
                        </div>
                    </div>

                    <div class="info-card vehicle-info-card" data-action="edit-vehicle" field="edit.vehicle.holder">
                        <div class="info-card-header">
                            <i class="fa fa-car"></i>
                            <h4>Licencing Information</h4>
                            <div class="info-badge escrow-ad-item-state"></div>
                        </div>
                        <div class="info-card-content">
                            <div class="info-item">
                                <span class="info-label">Name:</span>
                                <span class="escrow-ad-item-name"></span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Year:</span>
                                <span class="info-value escrow-ad-item-year"></span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Plate:</span>
                                <span class="info-value escrow-ad-item-plate"></span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">VIN:</span>
                                <span class="info-value escrow-ad-item-vin"></span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Price:</span>
                                <span class="info-value escrow-ad-item-price"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <input type="hidden" t-att-value="campaign or ''" field="campaign.name"/>
            <input type="hidden" name="partner" t-att-value="partner.id" field="partner"/>
            <input type="hidden" t-att-data-decimal="currency.decimal_places" t-att-data-separator="language.decimal_point" t-att-data-thousand="language.thousands_sep" t-att-data-name="currency.name" t-att-data-id="currency.id" t-att-data-position="currency.position" t-att-data-symbol="currency.symbol" field="currency"/>
        </t>
    </template>

    <template id="payment_step5_completion_modal" name="Step Item Template">
        <div id="step5CompletionModal" class="step5-modal d-none">
            <div class="step5-modal-overlay">
                <div class="step5-modal-content">
                    <div class="step5-header">
                        <div class="step5-steps">
                            <div class="step completed">1</div>
                            <div class="step completed">2</div>
                            <div class="step completed">3</div>
                            <div class="step completed">4</div>
                            <div class="step completed active">5</div>
                        </div>
                    </div>
                    
                    <div class="step5-body">
                        <div class="step5-success-icon">
                            <svg width="80" height="80" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="12" cy="12" r="10" fill="#10B981"/>
                                <path d="M9 12l2 2 4-4" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        
                        <h2 class="step5-title">Payment Completed Successfully!</h2>
                        <p class="step5-description">
                            Your escrow payment has been completed and the transaction is now secure.
                            You will receive notifications about the transaction progress.
                        </p>
                        
                        <div class="step5-transaction-info">
                            <div class="info-row">
                                <span class="label">Transaction Status:</span>
                                <span class="value success">Completed</span>
                            </div>
                            <div class="info-row">
                                <span class="label">Security Level:</span>
                                <span class="value">Escrow Protected</span>
                            </div>
                            <div class="info-row">
                                <span class="label">Next Step:</span>
                                <span class="value">Await seller confirmation</span>
                            </div>
                        </div>
                        
                        <div class="step5-actions">
                            <button class="btn-step5-primary" onclick="closeStep5Modal()">
                                Continue to My Ads
                            </button>
                            <button class="btn-step5-secondary" onclick="window.open('/my/transactions', '_blank')">
                                View Transaction Details
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="page_broker_settings" name="Broker Settings Page">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <t t-set="s2s" t-value="True"/>
            <t t-set="class" t-value="True"/>
            <t t-set="title" t-value="website.name"/>
            <t t-set="body_classname" t-value="'payment-page payment-escrow broker-settings'"/>
            <t t-set="language" t-value="request.env['res.lang']._lang_get(request.env.lang)"/>
            <t t-set="x_icon" t-value="'/web/image?model=website&amp;id=%s&amp;field=favicon' % website.id"/>
            <t t-call="payment_jetcheckout.payment_loading"/>
            <t t-call="payment_escrow.background_animation"/>

            <div class="escrow-ad-wrapper d-none">
                <t t-call="payment_escrow.header">
                    <t t-set="variant" t-value="'ads'"/>
                    <t t-set="company" t-value="company"/>
                </t>

                <div class="escrow-ad-container broker-settings-container">
                    <div class="container-fluid px-4 py-4">
                        <div class="row">
                            <div class="col-12">
                                <div class="card border-0 shadow-sm mb-4 p-4">
                                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3">
                                        <div class="mb-3 mb-md-0">
                                            <h3 class="h4 mb-1 font-weight-bold text-primary">Broker Settings</h3>
                                            <p class="text-muted mb-0">Configure your default broker campaign preferences.</p>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <div class="field-container w-100">
                                                <select id="default_campaign" name="default_campaign" 
                                                        class="text-center border-primary" required="required"
                                                        field="settings.campaign" data-role="campaign"
                                                        t-att-disabled="not campaigns and 'disabled' or None">
                                                    <option value="">Select Default Campaign</option>
                                                    <t t-if="campaigns">
                                                        <t t-foreach="campaigns" t-as="campaign">
                                                            <option t-att-value="campaign.id" 
                                                                    t-att-selected="default_campaign_id and campaign.id == default_campaign_id"
                                                                    t-esc="campaign.name"/>
                                                        </t>
                                                    </t>
                                                </select>
                                                <span class="bar-container"/>
                                                <label for="default_campaign" class="text-primary"><span>Default Campaign</span></label>
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <div class="field-container w-100">
                                                <input type="text" id="sign_name" name="sign_name" 
                                                       class="text-center border-primary" required="required"
                                                       field="settings.signName" data-role="sign-name"
                                                       t-att-value="partner.sign_name or ''"/>
                                                <span class="bar-container"/>
                                                <label for="sign_name" class="text-primary"><span>Sign Name</span></label>
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <div class="field-container w-100">
                                                <input type="text" id="authorized_person" name="authorized_person" 
                                                       class="text-center border-primary" required="required"
                                                       field="settings.authorizedPerson" data-role="authorized-person"
                                                       t-att-value="partner.authorized_person or ''"/>
                                                <span class="bar-container"/>
                                                <label for="authorized_person" class="text-primary"><span>Authorized Person</span></label>
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <div class="field-container w-100">
                                                <input type="email" id="email" name="email" 
                                                       class="text-center border-primary" required="required"
                                                       field="settings.email" data-role="email"
                                                       t-att-value="partner.email or ''"/>
                                                <span class="bar-container"/>
                                                <label for="email" class="text-primary"><span>Email</span></label>
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <div class="field-container w-100">
                                                <input type="tel" id="phone" name="phone" 
                                                       class="text-center border-primary" required="required"
                                                       field="settings.phone" data-role="phone"
                                                       t-att-value="partner.phone or ''"/>
                                                <span class="bar-container"/>
                                                <label for="phone" class="text-primary"><span>Phone</span></label>
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <div class="field-container w-100">
                                                <input type="tel" id="mobile" name="mobile" 
                                                       class="text-center border-primary"
                                                       field="settings.mobile" data-role="mobile"
                                                       t-att-value="partner.mobile or ''"/>
                                                <span class="bar-container"/>
                                                <label for="mobile" class="text-primary"><span>Mobile</span></label>
                                            </div>
                                        </div>
                                        <div class="col-12 text-right">
                                            <button type="button" class="btn btn-primary btn-lg px-5" 
                                                    field="settings.button.save" data-role="save">
                                                <i class="fa fa-save mr-2"/>
                                                Save Settings
                                            </button>
                                        </div>
                                    </div>

                                    <div class="alert alert-success mt-3 d-none" data-role="success">
                                        <i class="fa fa-check-circle mr-2"/>
                                        Settings saved successfully!
                                    </div>
                                    <div class="alert alert-danger mt-3 d-none" data-role="error">
                                        <i class="fa fa-exclamation-circle mr-2"/>
                                        <span data-role="error-message"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
