                                </svg>
                                <a href="#" class="download__link" field="assignment.form.download">Temlikname Formunu İndir</a>
                            </div>
                            <div class="form__label">Upload Assignment Form</div>
                            <div class="upload">
                                <input type="file" id="assignment-file-input" field="assignment.form.upload" accept=".pdf,.jpg,.jpeg,.png" multiple="multiple"/>
                                <label for="assignment-file-input">
                                    <svg width="42" height="42" viewBox="0 0 42 42" fill="none" xmlns="http://www.w3.org/2000/svg">
