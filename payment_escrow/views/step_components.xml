                                    </svg>
                                    <span>Upload Assignment Form</span>
                                </label>
                            </div>
                            <div class="upload-info" field="assignment.form.info">
                                <small class="text-muted">Accepted formats: PDF, JPG, PNG. Maximum size: 10MB</small>
                            </div>
                            <div class="upload-status" field="assignment.form.upload.status"></div>
                        </div>
                        <div class="form__buttons">
                            <div t-if="agreements" class="field-container field-agreement fade show" field="agreements">
                                <t t-foreach="agreements" t-as="agreement">
                                    <div class="btn btn-payment-agreement" t-att-data-id="agreement.id" field="agreement">
                                        <label class="switch">
                                            <input type="checkbox" class="d-none" t-att-checked="agreement.checked and 'checked' or None" t-att-required="agreement.required and 'required' or None" t-att-data-options="agreement.get_options()"/>
                                            <span class="slider round fa"/>
                                        </label>
                                        <label t-raw="agreement.text"/>
                                    </div>
                                </t>
                            </div>
                            <div class="form__group d-flex justify-content-between mt-3">
                                <div class="form__group mt-3">
                                    <button type="button" class="button button__dark button__medium" field="payment.button" data-wizard-action="next">
                                        Continue
                                        <i class="fa fa-chevron-right ml-2"/>
                                    </button>
                                </div>
                            </div>
                            <button type="submit" class="primaryButton d-none" id="btn_pay_now">
                                <div class="summary__priceBtn">
                                    <span>Payable Amount</span>
                                    <strong>2.400.000 TL</strong>
                                </div>
                                <span>Pay Now
                                    <svg width="20" height="15" viewBox="0 0 27 15" fill="" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M18.9653 12.9913C18.5033 13.4509 18.5033 14.1958 18.9653 14.6554C19.4272 15.1149 20.1762 15.1149 20.6381 14.6554L26.1568 9.1657C27.0806 8.24664 27.0806 6.75667 26.1568 5.8376L20.6346 0.344622C20.1727 -0.114876 19.4239 -0.114876 18.9618 0.344634C18.4999 0.804132 18.4999 1.54914 18.9618 2.00864L23.2983 6.32226H2.03246C1.37919 6.32226 0.849609 6.84904 0.849609 7.49889C0.849609 8.14863 1.37919 8.67552 2.03246 8.67552H23.3038L18.9653 12.9913Z" fill="white"/>
                                    </svg>
                                </span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>
</odoo>
