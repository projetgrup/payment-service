<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_paylox" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.paylox.installment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='general_settings']" position="inside">
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="installment_show_monthly" string="Installments Table"/>
                            <div class="text-muted">Show Monthly column on installment tables</div>
                            <field name="installment_show_monthly" widget="boolean_toggle"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
