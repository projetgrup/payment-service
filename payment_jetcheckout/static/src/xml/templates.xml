<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="paylox.installment.grid">
        <main t-if="!error &amp;&amp; tabs" class="row installment-table">
            <t t-if="type[0] === 'c'">
                <ul class="nav nav-tabs w-100 border-0 mb-1 type-ct" role="tablist">
                    <t t-set="i" t-value="0"/>
                    <t t-foreach="tabs" t-as="tab">
                        <li class="nav-item font-weight-bold">
                            <a t-attf-class="nav-link mr-2 rounded #{!i ? 'active' : ''}" t-att-id="'#installment-tab-' + i + '-tab'" data-toggle="tab" t-att-href="'#installment-tab-' + i" role="tab" t-att-aria-controls="'installment-tab-' + i" t-att-aria-selected="!i ? 'true' : 'false'" t-esc="format.type(tab)"/>
                            <t t-set="i" t-value="i+1"/>
                        </li>
                    </t>
                </ul>
                <div class="tab-content border type-ct">
                    <t t-set="i" t-value="0"/>
                    <t t-foreach="tabs" t-as="tab">
                        <div t-attf-class="tab-pane fade shadow-none #{!i ? 'show active' : ''}" t-att-id="'installment-tab-' + i" role="tabpanel" t-att-aria-labelledby="'installment-tab-' + i + '-tab'">
                            <div class="d-flex flex-wrap shadow-sm table-responsive">
                                <table class="table table-bordered m-0">
                                    <thead>
                                        <tr>
                                            <th class="text-center border-top-0 border-left-0"/>
                                            <t t-foreach="cols" t-as="col">
                                                <th class="text-center border-top-0">
                                                    <picture class="placeholder">
                                                        <img class="d-none" t-att-src="col.logo" t-att-alt="col.family"/>
                                                    </picture>
                                                </th>
                                            </t>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="rows" t-as="row">
                                            <tr class="text-center">
                                                <td class="text-nowrap font-weight-bold border-left-0" t-esc="row"/>
                                                <t t-foreach="cols" t-as="col">
                                                    <t t-set="line" t-value="lines?.[tab]?.[row]?.[col.family]?.[0]"/>
                                                    <t t-if="line">
                                                        <td class="text-center marked">
                                                            <t t-set="val" t-value="value * (1 + (line.crate / 100)) * (1 + (line.irate / 100))"/>
                                                            <div class="d-flex align-items-center font-weight-bold justify-content-center text-nowrap">
                                                                <span t-esc="line.id"/>
                                                                <span t-if="line.plus" t-esc="'+' + line.plus" class="badge badge-danger badge-pill p-1" t-att-title="line.pdesc"/>
                                                                <span class="ml-1">Installment</span>
                                                            </div>
                                                            <div class="text-nowrap">
                                                                <span t-esc="format.currency(val/line.count, position, symbol, decimal)"/> / <span t-esc="format.currency(val, position, symbol, decimal)"/>
                                                            </div>
                                                        </td>
                                                    </t>
                                                    <t t-else="">
                                                        <td/>
                                                    </t>
                                                </t>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <t t-set="i" t-value="i+1"/>
                    </t>
                </div>
            </t>
            <t t-else="">
                <ul class="nav nav-tabs w-100" role="tablist">
                    <t t-set="i" t-value="0"/>
                    <t t-foreach="tabs" t-as="tab">
                        <li class="nav-item font-weight-bold">
                            <a t-attf-class="nav-link #{!i ? 'active' : ''}" t-att-id="'#installment-tab-' + i + '-tab'" data-toggle="tab" t-att-href="'#installment-tab-' + i" role="tab" t-att-aria-controls="'installment-tab-' + i" t-att-aria-selected="!i ? 'true' : 'false'" t-esc="format.type(tab)"/>
                            <t t-set="i" t-value="i+1"/>
                        </li>
                    </t>
                </ul>
                <div class="tab-content">
                    <t t-set="i" t-value="0"/>
                    <t t-foreach="tabs" t-as="tab">
                        <div t-attf-class="tab-pane fade shadow-none #{!i ? 'show active' : ''}" t-att-id="'installment-tab-' + i" role="tabpanel" t-att-aria-labelledby="'installment-tab-' + i + '-tab'">
                            <div class="d-flex flex-wrap shadow-sm">
                                <t t-foreach="grids[tab]" t-as="grid">
                                    <div class="col-md-4 p-2">
                                        <div class="border bg-white text-700">
                                            <table class="w-100">
                                                <colgroup t-if="show_monthly">
                                                    <col width="20%"/>
                                                    <col width="40%"/>
                                                    <col width="40%"/>
                                                </colgroup>
                                                <colgroup t-else="">
                                                    <col width="20%"/>
                                                    <col width="80%"/>
                                                </colgroup>
                                                <thead>
                                                    <tr>
                                                        <th colspan="4" class="text-center">
                                                            <picture class="placeholder">
                                                                <img class="d-none" t-att-src="grid.logo" t-att-alt="grid.family"/>
                                                            </picture>
                                                        </th>
                                                    </tr>
                                                    <tr class="font-weight-bold bottom-border">
                                                        <td></td>
                                                        <td t-if="show_monthly" class="text-center">Monthly Payment</td>
                                                        <td class="text-center">Total Payment</td>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="grid.lines" t-as="line">
                                                        <t t-set="val" t-value="value * (1 + (line.crate / 100)) * (1 + (line.irate / 100))"/>
                                                        <tr>
                                                            <td class="text-center">
                                                                <span class="position-relative">
                                                                    <span t-esc="line.id"/>
                                                                    <span t-if="line.plus" t-esc="'+' + line.plus" class="badge badge-danger badge-pill p-1 ml4 position-absolute" t-att-title="line.pdesc"/>
                                                                </span>
                                                            </td>
                                                            <td t-if="show_monthly" class="text-center side-border">
                                                                <span t-esc="format.currency(val/line.count, position, symbol, decimal)"/>
                                                            </td>
                                                            <td class="text-center">
                                                                <span t-esc="format.currency(val, position, symbol, decimal)"/>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                        <t t-set="i" t-value="i+1"/>
                    </t>
                </div>
            </t>
        </main>
        <main t-else="" class="text-center h2 p-4 text-muted">
            No installment table found
        </main>
    </t>

    <t t-name="paylox.installment.row">
        <t t-if="type === 'c'">
            <t t-set="selected" t-value="true"/>
            <t t-foreach="rows" t-as="row">
                <div class="installment-line">
                    <div>
                        <span t-esc="row.id"/>
                    </div>
                    <t t-foreach="row.ids" t-as="r">
                        <t t-if="r.id">
                            <t t-set="val" t-value="value * (1 + (r.crate / 100)) * (1 + (r.irate / 100))"/>
                            <div t-attf-class="installment-cell text-center #{selected ? 'installment-selected' : ''}">
                                <input class="d-none" type="radio" t-att-name="r.id" t-att-value="r.id" t-att-checked="selected ? 'checked' : undefined" t-att-data-id="r.id" t-att-data-index="r.index" t-att-data-campaign="r.campaign"/>
                                <span t-esc="format.currency(val, position, symbol, decimal)"/>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="text-center"/>
                        </t>
                        <t t-set="selected" t-value="false"/>
                    </t>
                </div>
            </t>
        </t>
        <t t-elif="type === 'ct'">
            <t t-set="selected" t-value="true"/>
            <t t-foreach="rows" t-as="row">
                <t t-set="val" t-value="value * (1 + (row.crate / 100)) * (1 + (row.irate / 100))"/>
                <div t-attf-class="installment-line {{ selected ? 'installment-selected' : '' }}">
                    <div class="installment-cell overflow-hidden">
                        <div>
                            <input type="radio" class="d-block m-auto" t-att-name="row.id" t-att-value="row.id" t-att-checked="selected ? 'checked' : undefined" t-att-data-id="row.id" t-att-data-campaign="row.campaign"/>
                            <span class="installment-radio"/>
                        </div>
                        <div class="overflow-hidden text-nowrap text-overflow-ellipsis">
                            <span t-esc="row.campaign" t-att-title="row.campaign"/>
                        </div>
                    </div>
                    <div class="text-center side-border">
                        <span class="position-relative">
                            <span t-esc="row.id"/>
                            <span t-if="row.plus" t-esc="'+' + row.plus" class="badge badge-danger badge-pill p-1 ml4 position-absolute" t-att-title="row.pdesc"/>
                        </span>
                    </div>
                    <div t-if="show_monthly != False" class="text-center side-border">
                        <span t-esc="format.currency(val/row.count, position, symbol, decimal)"/>
                    </div>
                    <div class="text-center">
                        <span t-esc="format.currency(val, position, symbol, decimal)"/>
                    </div>
                </div>
                <t t-set="selected" t-value="false"/>
            </t>
        </t>
        <t t-else="">
            <t t-set="selected" t-value="true"/>
            <t t-foreach="rows" t-as="row">
                <t t-set="val" t-value="value * (1 + (row.crate / 100)) * (1 + (row.irate / 100))"/>
                <div t-attf-class="installment-line #{selected ? 'installment-selected' : ''}">
                    <div class="installment-cell">
                        <div class="text-center">
                            <input type="radio" t-att-name="row.id" t-att-value="row.id" t-att-checked="selected ? 'checked' : undefined" t-att-data-id="row.id" class="d-block mx-auto"/>
                            <span class="installment-radio"/>
                        </div>
                        <div class="flex-fill">
                            <span class="position-relative">
                                <span t-esc="row.id"/>
                                <span t-if="row.plus" t-esc="'+' + row.plus" class="badge badge-danger badge-pill p-1 ml4 position-absolute" t-att-title="row.pdesc"/>
                            </span>
                        </div>
                    </div>
                    <div t-if="!s2s" class="text-center side-border">
                        <span t-esc="format.percentage(row.crate)"/>
                    </div>
                    <div t-if="show_monthly != False" class="text-center side-border">
                        <span t-esc="format.currency(val/row.count, position, symbol, decimal)"/>
                    </div>
                    <div class="text-center">
                        <span t-esc="format.currency(val, position, symbol, decimal)"/>
                    </div>
                </div>
                <t t-set="selected" t-value="false"/>
            </t>
        </t>
    </t>

    <t t-name="paylox.installment.summary">
        <div class="text-center">
            <t t-set="val" t-value="value + (value * (row.crate || 0) / 100)"/>
            <i class="fa fa-asterisk small mr-2"/> <span t-esc="format.currency(val, position, symbol, decimal)"/>
            <span t-if="row.crate" class="small">(<t t-esc="format.currency(value, position, symbol, decimal)"/> + %<t t-esc="format.float(row.crate)"/> commission)</span>
            <span> will be charged from this credit card and it will be refunded immediately.</span>
        </div>
    </t>

    <t t-name="paylox.installment.col">
        <t t-if="type === 'c'">
            <div class="text-center"><t t-if="s2s">Install.</t><t t-else="">Installment</t></div>
            <t t-if="!cols.length">
                <div class="text-center">Campaign</div>
            </t>
            <t t-else="">
                <t t-foreach="cols" t-as="col">
                    <div class="text-center" t-esc="col"/>
                </t>
            </t>
        </t>
        <t t-else="">
            <div class="text-center"><t t-if="s2s">Install.</t><t t-else="">Installment</t></div>
            <div t-if="!s2s" class="text-center">Rate</div>
            <div t-if="show_monthly != False" class="text-center">Monthly</div>
            <div class="text-center">Total</div>
        </t>
    </t>

    <t t-name="paylox.token.select">
        <div t-if="id === -1" class="card-token-option d-flex align-items-center">
            <i class="fa fa-credit-card mr-3" style="font-size: 1.1em;"/>
            <span t-esc="text"/>
        </div>
        <div t-elif="id === 0" class="card-token-option d-flex align-items-center">
            <i class="fa fa-credit-card-alt"/>
            <i class="fa fa-plus ml-1 mr-2 mb-2" style="font-size: 0.5em;"/>
            <span t-esc="text"/>
        </div>
        <div t-elif="id" class="card-token-selection d-flex align-items-center">
            <div class="d-flex bg-white align-items-center" style="min-height:36px;border-radius:6px;width:78px;">
                <t t-set="iconFamily" t-value="search.family(family)?.icon"/>
                <img t-if="iconFamily" class="m-auto" t-att-src="'data:image/svg+xml;base64,' + iconFamily" style="width:90%"/>
            </div>
            <div class="d-flex flex-column ml-2 font-weight-bold small" style="letter-spacing:1px;">
                <div t-esc="token.name"/>
                <div class="d-flex align-items-center mt-n1">
                    <span t-esc="text.slice(0,4) + ' ' + text.slice(4,8) + ' ' + text.slice(8,12) + ' ' + text.slice(12,16)" class="mr-2"/>
                    <t t-set="iconProgram" t-value="search.program(program)?.icon"/>
                    <img t-if="iconProgram" t-att-src="'data:image/svg+xml;base64,' + iconProgram" style="height:20px"/>
                </div>
            </div>
        </div>
        <div t-else="">
            <span t-esc="text"/>
        </div>
    </t>

    <t t-name="paylox.token.radio">
        <t t-foreach="tokens" t-as="token">
            <button class="btn btn-light text-left text-700 card-token-radio d-flex align-items-center position-relative p-2 border">
                <div class="d-flex bg-white align-items-center" style="min-height:36px;border-radius:6px;width:78px;">
                    <t t-set="iconFamily" t-value="search.family(family)?.icon"/>
                    <img t-if="iconFamily" class="m-auto" t-att-src="'data:image/svg+xml;base64,' + iconFamily" style="width:90%"/>
                </div>
                <div class="d-flex flex-column ml-2 font-weight-bold small" style="letter-spacing:1px;">
                    <div t-esc="token.name"/>
                    <div class="d-flex align-items-center mt-n1">
                        <span t-esc="text.slice(0,4) + ' ' + text.slice(4,8) + ' ' + text.slice(8,12) + ' ' + text.slice(12,16)" class="mr-2"/>
                        <t t-set="iconProgram" t-value="search.program(program)?.icon"/>
                        <img t-if="iconProgram" t-att-src="'data:image/svg+xml;base64,' + iconProgram" style="height:20px"/>
                    </div>
                </div>
                <div class="card-token-check">
                    <input type="radio" name="card-token-radio" t-att-value="token.id" t-att-data-value="token.text"/>
                    <i class="fa fa-check-circle text-primary"/>
                </div>
                <div class="card-token-remove">
                    <span class="btn"><i class="fa fa-trash text-500"/></span>
                </div>
                <div class="card-token-loading fade"/>
            </button>
        </t>
        <button t-if="tokens.length" class="btn btn-light card-token-radio card-token-radio-add text-primary position-relative p-2">
            <span>Pay with another card</span>
            <div class="card-token-check">
                <input type="radio" name="card-token-radio" value="0" checked="checked"/>
                <i class="fa fa-check-circle text-primary"/>
            </div>
        </button>
        <button t-else="" class="btn btn-light card-token-radio card-token-radio-new text-primary position-relative">
            <span>Save a new credit card</span>
            <div class="card-token-check">
                <input type="radio" name="card-token-radio" value="0" checked="checked"/>
                <i class="fa fa-check-circle text-primary"/>
            </div>
        </button>
    </t>

    <t t-name="paylox.campaigns">
        <table style="border:none !important">
            <colgroup>
                <col width="5px"/>
                <col width="60%"/>
                <col width=""/>
            </colgroup>
            <t t-foreach="campaigns" t-as="campaign" t-key="campaign.id">
                <t t-set="selected" t-value="campaign.name === current"/>
                <tr>
                    <td t-attf-class="#{selected ? 'bg-success' : ''}"/>
                    <td class="font-weight-bold h4 text-700 text-center">
                        <span t-if="campaign.id" t-esc="campaign.name"/>
                        <span t-else="">Default</span>
                    </td>
                    <td t-if="selected" class="text-center py-1">
                        <button class="btn rounded font-weight-bold btn-success disabled" t-att-data-name="campaign.name" disabled=""><i class="fa fa-check mr-2" t-translation="off"/>Select</button>
                    </td>
                    <td t-else="" class="text-center p-1">
                        <button class="btn rounded font-weight-bold btn-success o_button_select_campaign" t-att-data-name="campaign.name"><i class="fa fa-check mr-2" t-translation="off"/>Select</button>
                    </td>
                </tr>
            </t>
        </table>
    </t>

    <t t-name="paylox.warning.commission">
        <t t-set="total" t-value="amount * (1 + (row.crate / 100)) * (1 + (row.irate / 100))"/>
        <main class="text-center">
            <i class="fa fa-exclamation-triangle fa-3x text-warning"/>
            <!--<div class="mt-4 text-700" style="font-size:1.1em">
                You're about to make payment with <strong t-esc="row.id" class="text-primary"/> installment(s)<t t-if="warning.show_rate"> and <strong t-esc="format.percentage(row.crate)" class="text-primary" /> commission rate</t>.
            </div>-->
            <div class="mt-4 text-700" style="font-size:1.1em">
                Ödemenizi <strong t-esc="row.id" class="text-primary"/> taksit <t t-if="warning.show_rate"> ve <strong t-esc="format.percentage(row.crate)" class="text-primary" /> komisyon oranı </t> ile tamamlamak üzeresiniz.
            </div>
            <!--<div class="mt-4 text-700" style="font-size:1.1em">
                Calculated payment amount will be <strong t-esc="format.currency(total, position, symbol, decimal)" class="text-primary"/>.
            </div>-->
            <div class="mt-4 text-700" style="font-size:1.1em">
                Ödenecek tutar <strong t-esc="format.currency(total, position, symbol, decimal)" class="text-primary"/> olarak hesaplanmıştır.
            </div>
            <div t-if="warning.show_calculation" class="mt-4 text-muted">
                <table align="center">
                    <tr>
                        <td style="width:10px"/>
                        <td class="text-right"><span t-esc="format.currency(amount, position, symbol, decimal)"/></td>
                        <td class="font-italic text-left pl-2">(Base Amount)</td>
                    </tr>
                    <!--<tr>
                        <td>+</td>
                        <td class="text-right"><span t-esc="format.currency(total-amount, position, symbol, decimal)"/></td>
                        <td class="font-italic text-left pl-2">(<t t-if="show_rate">Commission Rate</t><t t-else="">Service Fee</t> <span t-esc="format.percentage(row.crate)" class="small"/>)*</td>
                    </tr>-->
                    <tr>
                        <td>+</td>
                        <td class="text-right"><span t-esc="format.currency(total-amount, position, symbol, decimal)"/></td>
                        <td class="font-italic text-left pl-2">(<t t-if="show_rate">Komisyon Oranı</t><t t-else="">Hizmet Bedeli</t> <span t-esc="format.percentage(row.crate)" class="small"/>)*</td>
                    </tr>
                    <tr>
                        <td class="border-top"/>
                        <td class="text-right border-top"><span t-esc="format.currency(total, position, symbol, decimal)"/></td>
                        <td class="border-top text-left font-italic pl-2">(Payment Amount)</td>
                    </tr>
                    <!--<tr t-if="row.id > 0">
                        <td class="font-italic pt-2" colspan="3">* Monthly <t t-if="show_rate">commission amount</t><t t-else="">service fee</t> will be <span t-esc="format.currency(total/row.id, position, symbol, decimal)"/> (<span t-esc="format.percentage(row.crate/row.id)" class="small"/>)</td>
                    </tr>-->
                    <tr t-if="row.id > 0">
                        <td class="font-italic pt-2" colspan="3">* <t t-if="show_rate">komisyon tutarı</t><t t-else="">hizmet bedeli</t> <span t-esc="format.currency((total-amount)/row.id, position, symbol, decimal)"/> olacaktır (<span t-esc="format.percentage(row.crate/row.id)" class="small"/>)</td>
                    </tr>
                </table>
            </div>
            <div t-if="warning.description" class="mt-4 mt-n4 text-muted">
                <t t-raw="warning.description"/>
            </div>
            <t t-set="advise1" t-value="warning.show_primary_advice &amp;&amp; advisor(1)"/>
            <div t-if="advise1" class="mt-4 mx-n4 px-4 pt-3 text-700 border-top position-relative">
                <div class="position-absolute" style="border-left: 24px solid #ddd; border-bottom: 24px solid transparent; width: 0; height: 0; top: 0; left: 0;">
                    <i class="fa fa-star text-primary" style="position: absolute; top: 4px; left: -18px;"/>
                </div>
                <!--<div>
                    You can choose <strong t-esc="advise1" class="text-primary"/> installment(s) to make payment without <t t-if="show_rate">commission amount</t><t t-else="">service fee</t>.
                </div>
                <button name="popupWarningCommissionButton" class="mt-3 btn btn-outline-primary btn-block font-weight-bold" style="border-radius: 10px !important; padding: 10px 40px !important;" t-att-data-id="advise1">Pay with <t t-esc="advise1"/> installment(s)</button>-->
                <div>
                    <strong t-esc="advise1" class="text-primary"/> taksit seçerek herhangi bir <t t-if="show_rate">komisyon tutarı</t><t t-else="">hizmet bedeli</t> ödemeden ödemeninizi tamamlayabilirsiniz.
                </div>
                <button name="popupWarningCommissionButton" class="mt-3 btn btn-outline-primary btn-block font-weight-bold" style="border-radius: 10px !important; padding: 10px 40px !important;" t-att-data-id="advise1"><t t-esc="advise1"/> taksit ile öde</button>
            </div>
            <t t-set="advise2" t-value="warning.show_secondary_advice &amp;&amp; advisor(2)"/>
            <div t-if="advise2" class="mt-4 mx-n4 px-4 pt-3 text-700 border-top position-relative">
                <div class="position-absolute" style="border-left: 24px solid #ddd; border-bottom: 24px solid transparent; width: 0; height: 0; top: 0; left: 0;">
                    <i class="fa fa-star text-primary" style="position: absolute; top: 4px; left: -18px;"/>
                </div>
                <!--<div>
                    You can choose <strong t-esc="advise2.id" class="text-primary"/> installment(s) to make payment with lowest monthly <t t-if="show_rate">commission amount</t><t t-else="">service fee</t> (<span t-esc="format.percentage(advise2.rate)" class="small"/>).
                </div>
                <button name="popupWarningCommissionButton" class="mt-3 btn btn-outline-primary btn-block font-weight-bold" style="border-radius: 10px !important; padding: 10px 40px !important;" t-att-data-id="advise2.id">Pay with <t t-esc="advise2.id"/> installment(s)</button>-->
                <div>
                    <strong t-esc="advise2.id" class="text-primary"/> taksit seçerek aylık bazda en düşük <t t-if="show_rate">komisyon tutarı</t><t t-else="">hizmet bedeli</t> ile ödemenizi tamamlayabilirsiniz (<span t-esc="format.percentage(advise2.rate)" class="small"/>).
                </div>
                <button name="popupWarningCommissionButton" class="mt-3 btn btn-outline-primary btn-block font-weight-bold" style="border-radius: 10px !important; padding: 10px 40px !important;" t-att-data-id="advise2.id"><t t-esc="advise2.id"/> taksit ile öde</button>
            </div>
        </main>
    </t>
</templates>
