<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="tree_provider" model="ir.ui.view">
    <field name="model">sms.provider</field>
    <field name="inherit_id" ref="sms_api.provider_tree"/>
    <field name="arch" type="xml">
        <xpath expr="//tree" position="attributes">
            <attribute name="edit">0</attribute>
        </xpath>
        <xpath expr="//field[@name='username']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='password']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
    </field>
    </record>

    <record id="form_provider" model="ir.ui.view">
    <field name="model">sms.provider</field>
    <field name="inherit_id" ref="sms_api.provider_form"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='username']" position="before">
            <field name="syncops_connector_id" options="{'no_create': True}" attrs="{'invisible': [('type', '!=', 'syncops')], 'required': [('type', '=', 'syncops')]}" string="Connector"/>
        </xpath>
        <xpath expr="//field[@name='username']" position="attributes">
            <attribute name="attrs">{'invisible': [('type', '=', 'syncops')], 'required': [('type', '!=', 'syncops')]}</attribute>
        </xpath>
        <xpath expr="//field[@name='password']" position="attributes">
            <attribute name="attrs">{'invisible': [('type', '=', 'syncops')], 'required': [('type', '!=', 'syncops')]}</attribute>
        </xpath>
    </field>
    </record>
</odoo>
