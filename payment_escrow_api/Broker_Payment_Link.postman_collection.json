{
	"info": {
		"name": "Escrow API - Broker Payment Link",
		"description": "Broker için ödeme linki oluşturma",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Generate Broker Payment Link",
			"request": {
				"auth": {
					"type": "basic",
					"basic": [
						{
							"key": "username",
							"value": "{{api_username}}",
							"type": "string"
						},
						{
							"key": "password",
							"value": "{{api_password}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"broker_id\": 123\n}"
				},
				"url": {
					"raw": "{{base_url}}/escrow/api/brokers/payment-link",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"escrow",
						"api",
						"brokers",
						"payment-link"
					]
				},
				"description": "Broker ID gönderip 15 dakika geçerli ödeme linki alır"
			},
			"response": [
				{
					"name": "Success Response",
					"originalRequest": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"broker_id\": 123\n}"
						},
						"url": {
							"raw": "{{base_url}}/escrow/api/brokers/payment-link",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"escrow",
								"api",
								"brokers",
								"payment-link"
							]
						}
					},
					"status": "OK",
					"code": 200,
					"_postman_previewlanguage": "json",
					"header": [
						{
							"key": "Content-Type",
							"value": "application/json"
						}
					],
					"cookie": [],
					"body": "{\n    \"status\": 200,\n    \"message\": \"OK\",\n    \"url\": \"https://example.com/my/ads/broker?token=MTIzOjE3MzI3ODkwMDA=\",\n    \"expires_at\": \"2025-11-22 14:15:00\"\n}"
				},
				{
					"name": "Broker Not Found",
					"originalRequest": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"broker_id\": 999\n}"
						},
						"url": {
							"raw": "{{base_url}}/escrow/api/brokers/payment-link",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"escrow",
								"api",
								"brokers",
								"payment-link"
							]
						}
					},
					"status": "Not Found",
					"code": 404,
					"_postman_previewlanguage": "json",
					"header": [
						{
							"key": "Content-Type",
							"value": "application/json"
						}
					],
					"cookie": [],
					"body": "{\n    \"status\": 404,\n    \"message\": \"Broker not found\"\n}"
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8069",
			"type": "string"
		},
		{
			"key": "api_username",
			"value": "your_api_username",
			"type": "string"
		},
		{
			"key": "api_password",
			"value": "your_api_password",
			"type": "string"
		}
	]
}
