<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="payment_syncops.SyncProgressWidget">
        <div class="o_sync_progress_widget" style="position: fixed; bottom: 20px; right: 20px; width: 350px; z-index: 9999;">
            <div class="alert alert-info mb-0 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong>Sync Progress</strong>
                    <div>
                        <span class="badge badge-primary mr-2"><t t-esc="processed"/> / <t t-esc="total"/></span>
                        <button type="button" class="close o_sync_cancel" aria-label="Close">
                            <span aria-hidden="true">&amp;times;</span>
                        </button>
                    </div>
                </div>
                <div class="progress mb-2" style="height: 25px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated" 
                         role="progressbar" 
                         t-att-style="'width: ' + percent + '%'"
                         t-att-aria-valuenow="percent" 
                         aria-valuemin="0" 
                         aria-valuemax="100">
                        <t t-esc="percent"/>%
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <small class="text-muted"><t t-esc="message"/></small>
                    <button type="button" class="btn btn-sm btn-danger o_sync_toggle_errors" style="display: none; padding: 0px 5px; font-size: 10px;">
                        Errors <span class="badge badge-light o_error_count">0</span>
                    </button>
                </div>
                <div class="o_sync_errors mt-2" style="display: none; max-height: 150px; overflow-y: auto;">
                    <div class="alert alert-danger mb-0 p-2">
                        <ul class="pl-3 mb-0 text-left"></ul>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>