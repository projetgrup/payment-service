<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="page_redirect" name="Mobile Redirect Page">
        <t t-call="web.layout">
            <t t-set="html_data" t-value="{'style': 'height: 100%;'}"/>
            <t t-set="body_classname" t-value="'bg-100'"/>
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <link rel="preload" href="/web/static/lib/fontawesome/fonts/fontawesome-webfont.woff2?v=4.7.0" as="font" crossorigin=""/>
                <t t-call-assets="web.assets_common" t-js="false"/>
                <t t-call-assets="web.assets_frontend" t-js="false"/>
                <t t-call-assets="web.assets_common_minimal" t-css="false" defer_load="True"/>
                <t t-call-assets="web.assets_frontend_minimal" t-css="false" defer_load="True"/>
                <t t-call-assets="web.assets_common_lazy" t-css="false" lazy_load="True"/>
                <t t-call-assets="web.assets_frontend_lazy" t-css="false" lazy_load="True"/>
            </t>
            <main class="o_mobile_redirect m-auto">
                <div class="o_booting"/>
                <div t-if="len(route_urls) == 1" class="o_redirecting hide p-3">
                    <p>You will be redirecting to</p>
                    <p class="h2 my-3" t-esc="route_urls[0]"/>
                    <p class="my-3">in <span name="timer" class="h3">5</span> seconds...</p>
                    <button class="btn btn-primary btn-block btn-level btn-redirect-cancel shadow-none mt-3">Cancel</button>
                </div>
                <div class="o_loading hide">
                    <em class="fa fa-2x fa-spin fa-circle-o-notch"/>
                </div>
                <div class="bottom-container"/>
                <div class="container">
                    <div class="card shadow border-0 mx-auto mt-n5">
                        <div class="card-body p-4">
                            <div class="text-center px-4">
                                <img src="/web_mobile_application/static/img/logo.png" alt="Logo" class="img img-fluid"/>
                            </div>
                            <div class="o_redirect_form">
                                <t t-foreach="route_urls" t-as="url">
                                    <div class="mt-4">
                                        <button class="btn btn-primary btn-block btn-level btn-redirect-url d-flex align-items-center shadow-none" t-att-data-value="url">
                                            <div class="flex-fill" t-esc="url"/>
                                            <em class="fa fa-times"/>
                                        </button>
                                    </div>
                                </t>
                                <form class="oe_redirect_form" role="form" method="post">
                                    <input type="hidden" id="token" name="auth_token" t-att-value="auth_token"/>
                                    <div class="form-group field-login">
                                        <i class="fa fa-external-link"/>
                                        <input type="text" placeholder="Address..." name="url" id="url" required="required" autofocus="autofocus" autocapitalize="off" inputmode="url"/>
                                        <div t-attf-class="clearfix oe_login_buttons text-center mb-1">
                                            <button type="submit" class="btn btn-primary btn-block btn-level btn-redirect shadow-none">Continue</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </t>
    </template>
</odoo>
